---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/', labelIt: 'Home', labelEn: 'Home' },
  { href: '/techtips', labelIt: 'TechTips', labelEn: 'TechTips' },
  { href: '/modifiche', labelIt: 'Modifiche', labelEn: 'Modifications' },
  { href: '/storia', labelIt: 'Storia', labelEn: 'History' },
  { href: '/download', labelIt: 'Download / Cataloghi', labelEn: 'Downloads' },
  { href: '/about', labelIt: 'About', labelEn: 'About' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/90 dark:bg-alfa-metal-950/90 border-b border-alfa-metal-200 dark:border-alfa-metal-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="group flex items-center space-x-3.5 focus:outline-none" aria-label="156dotnet Home">
        <!-- Alfa Romeo stylized Scudetto V-Shield -->
        <div class="relative w-10 h-12 flex-shrink-0 transition-transform duration-300 group-hover:scale-105">
          <svg viewBox="0 0 100 120" class="w-full h-full drop-shadow-[0_2px_8px_rgba(153,0,0,0.35)]" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Scudetto Outer Shield Frame with metallic border -->
            <path
              d="M50 116 C40 100, 4 60, 4 10 L50 2 L96 10 C96 60, 60 100, 50 116 Z"
              fill="#14151a"
              stroke="#990000"
              stroke-width="5"
            />
            <!-- Inner Red V-core -->
            <path
              d="M50 105 C42 90, 12 55, 12 16 L50 10 L88 16 C88 55, 58 90, 50 105 Z"
              fill="#990000"
            />
            <!-- Horizontal Chrome Bars (classic 156 grille) -->
            <line x1="20" y1="35" x2="80" y2="35" stroke="#f4f6f8" stroke-width="2.5" stroke-linecap="round" />
            <line x1="26" y1="52" x2="74" y2="52" stroke="#f4f6f8" stroke-width="2.5" stroke-linecap="round" />
            <line x1="32" y1="69" x2="68" y2="69" stroke="#f4f6f8" stroke-width="2.5" stroke-linecap="round" />
            <line x1="39" y1="86" x2="61" y2="86" stroke="#f4f6f8" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </div>

        <!-- Typography -->
        <div class="flex flex-col">
          <div class="flex items-center space-x-1">
            <span class="font-display font-extrabold text-2xl tracking-tighter text-alfa-red-600 dark:text-alfa-red-500">156</span>
            <span class="font-display font-bold text-xl tracking-tight text-alfa-metal-900 dark:text-white">dotnet</span>
          </div>
          <span class="text-[10px] font-semibold tracking-wider uppercase text-alfa-metal-500 dark:text-alfa-metal-400 -mt-1 group-hover:text-alfa-red-600 dark:group-hover:text-alfa-red-400 transition-colors">
            Cuore Sportivo Archive
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`relative px-3 py-2 text-sm font-semibold rounded-lg transition-all duration-200 ${
                active
                  ? 'text-alfa-red-600 dark:text-alfa-red-400 bg-alfa-red-50/70 dark:bg-alfa-red-950/40 font-bold'
                  : 'text-alfa-metal-700 dark:text-alfa-metal-300 hover:text-alfa-red-600 dark:hover:text-white hover:bg-alfa-metal-100/70 dark:hover:bg-alfa-metal-900/60'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <span class="lang-it">{link.labelIt}</span>
              <span class="lang-en">{link.labelEn}</span>
              {active && (
                <span class="absolute bottom-0 left-2 right-2 h-0.5 bg-alfa-red-600 dark:bg-alfa-red-500 rounded-full shadow-[0_0_8px_rgba(153,0,0,0.8)]" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions: Language Toggle, Theme Toggle, Mobile Menu button -->
      <div class="flex items-center space-x-2 sm:space-x-2.5">
        
        <!-- Search Trigger (Pagefind ready) -->
        <button
          id="search-trigger"
          type="button"
          class="hidden xl:inline-flex items-center space-x-2 px-3 py-1.5 rounded-xl text-xs font-medium text-alfa-metal-500 dark:text-alfa-metal-400 bg-alfa-metal-100/90 dark:bg-alfa-metal-900/80 hover:bg-alfa-metal-200 dark:hover:bg-alfa-metal-800 border border-alfa-metal-200 dark:border-alfa-metal-700/80 transition-colors"
          title="Cerca nell'archivio (Ctrl+K)"
        >
          <svg class="w-4 h-4 text-alfa-red-600 dark:text-alfa-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="lang-it">Cerca guide...</span>
          <span class="lang-en">Search guides...</span>
          <kbd class="inline-block px-1.5 py-0.5 text-[10px] font-mono font-semibold bg-white dark:bg-alfa-metal-800 border border-alfa-metal-300 dark:border-alfa-metal-700 rounded shadow-xs">
            Ctrl+K
          </kbd>
        </button>

        <!-- Language Toggle (IT / EN) -->
        <LanguageToggle />

        <!-- Theme Toggle (Light / Dark) -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden inline-flex items-center justify-center p-2 rounded-xl text-alfa-metal-700 dark:text-alfa-metal-300 hover:text-alfa-red-600 dark:hover:text-white hover:bg-alfa-metal-100 dark:hover:bg-alfa-metal-800 focus:outline-none"
          aria-expanded="false"
          aria-label="Apri menu principale"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-alfa-metal-200 dark:border-alfa-metal-800 bg-white dark:bg-alfa-metal-950 px-4 pt-3 pb-6 space-y-2">
    <!-- Mobile Search input -->
    <div class="mb-3">
      <a
        href="/techtips"
        class="flex items-center space-x-2 w-full px-3 py-2 rounded-lg text-sm text-alfa-metal-500 bg-alfa-metal-100 dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800"
      >
        <svg class="w-4 h-4 text-alfa-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="lang-it">Cerca guide e diagnosi...</span>
        <span class="lang-en">Search guides & diagnostics...</span>
      </a>
    </div>

    <!-- Mobile Nav Links -->
    {navLinks.map((link) => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block px-3.5 py-2.5 rounded-lg text-base font-medium transition-colors ${
            active
              ? 'text-alfa-red-600 dark:text-alfa-red-400 bg-alfa-red-50 dark:bg-alfa-red-950/50 font-bold border-l-4 border-alfa-red-600'
              : 'text-alfa-metal-800 dark:text-alfa-metal-200 hover:text-alfa-red-600 dark:hover:text-white hover:bg-alfa-metal-50 dark:hover:bg-alfa-metal-900'
          }`}
        >
          <span class="lang-it">{link.labelIt}</span>
          <span class="lang-en">{link.labelEn}</span>
        </a>
      );
    })}
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu || !iconOpen || !iconClose) return;

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
