  { motor: '2.0 JTS 16V', power: '121 (165) / 6400', ccm: '1970', torque: '206 (3250)', topSpeed: '220', accel: '8.2', weight: '1280', wheels: '205/60 R15' },
  { motor: '2.4 JTD 10V', power: '110 (150) / 4000', ccm: '2387', torque: '305 (1800)', topSpeed: '212', accel: '9.4', weight: '1385', wheels: '185/65 R15' },
  { motor: '2.4 Multijet 20V (2003)', power: '129 (175) / 4000', ccm: '2387', torque: '385 (2000)', topSpeed: '225', accel: '8.3', weight: '1410', wheels: '225/45 R17' }
