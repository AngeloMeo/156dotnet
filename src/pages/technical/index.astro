// Engines 2001-> (Euro 3)
const enginesEuro3 = [
  { motor: '1.6 TS 16V', power: '88 (120) / 6200', ccm: '1598', torque: '146 (4200)', topSpeed: '200', accel: '10.5', weight: '1230', wheels: '185/65 R15' },
  { motor: '1.8 TS 16V', power: '103 (140) / 6500', ccm: '1747', torque: '163 (3900)', topSpeed: '208', accel: '9.4', weight: '1230', wheels: '185/65 R15' },
  { motor: '2.0 TS 16V *', power: '110 (150) / 6300', ccm: '1970', torque: '181 (3800)', topSpeed: '214', accel: '8.8', weight: '1250', wheels: '205/60 R15' },
  { motor: '2.5 V6 24V', power: '141 (192) / 6300', ccm: '2492', torque: '218 (5000)', topSpeed: '230', accel: '7.3', weight: '1320', wheels: '205/60 R15' },
  { motor: '1.9 JTD', power: '81 (110) / 4000', ccm: '1910', torque: '275 (1800)', topSpeed: '191', accel: '10.3', weight: '1270', wheels: '185/65 R15' },
  { motor: '2.4 JTD *', power: '103 (140) / 4000', ccm: '2387', torque: '304 (1800)', topSpeed: '205', accel: '9.4', weight: '1350', wheels: '185/65 R15' }
