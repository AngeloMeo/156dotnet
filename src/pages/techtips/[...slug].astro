---
// techtips/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightboxGallery from '../../components/LightboxGallery.astro';

export async function getStaticPaths() {
  const techtips = await getCollection('techtips');
  return techtips.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const difficultyColors = {
  Facile: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
  Medio: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30',
  Avanzato: 'bg-alfa-red-600/10 text-alfa-red-600 dark:text-alfa-red-400 border-alfa-red-600/30',
};

const defaultDifficultyEn = {
  Facile: 'Easy',
  Medio: 'Medium',
  Avanzato: 'Advanced',
};
---

<BaseLayout
  title={`${entry.data.title} – Guida Alfa 156 (156dotnet)`}
  description={entry.data.description}
  image={entry.data.featuredImage}
>
  <!-- Breadcrumb -->
  <nav class="bg-alfa-metal-100 dark:bg-alfa-metal-900 border-b border-alfa-metal-200 dark:border-alfa-metal-800/80 py-3 text-xs text-alfa-metal-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center space-x-2">
      <a href="/" class="hover:text-alfa-red-600 transition-colors">Home</a>
      <span>/</span>
      <a href="/techtips" class="hover:text-alfa-red-600 transition-colors">TechTips</a>
      <span>/</span>
      <span class="text-alfa-metal-800 dark:text-alfa-metal-200 font-medium truncate max-w-xs sm:max-w-md">
        <span class="lang-it">{entry.data.title}</span>
        <span class="lang-en">{entry.data.title_en || entry.data.title}</span>
      </span>
    </div>
  </nav>

  <!-- Guide Hero Section -->
  <header class="py-12 bg-white dark:bg-alfa-metal-950 border-b border-alfa-metal-200 dark:border-alfa-metal-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl space-y-4">
        
        <!-- Category & Difficulty pills -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-md text-xs font-semibold bg-alfa-red-600 text-white shadow-xs">
            <span class="lang-it">{entry.data.category}</span>
            <span class="lang-en">{entry.data.category_en || entry.data.category}</span>
          </span>
          <span class={`px-3 py-0.5 rounded-full text-xs font-semibold border ${difficultyColors[entry.data.difficulty]}`}>
            <span class="lang-it">Difficoltà: {entry.data.difficulty}</span>
            <span class="lang-en">Difficulty: {entry.data.difficulty_en || defaultDifficultyEn[entry.data.difficulty]}</span>
          </span>
          <span class="px-3 py-0.5 rounded-full text-xs font-medium bg-alfa-metal-100 dark:bg-alfa-metal-800 text-alfa-metal-700 dark:text-alfa-metal-300 border border-alfa-metal-200 dark:border-alfa-metal-700">
            ⏱ <span class="lang-it">Tempo: {entry.data.timeRequired}</span>
            <span class="lang-en">Time: {entry.data.timeRequired_en || entry.data.timeRequired}</span>
          </span>
        </div>

        <!-- Title -->
        <h1 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-alfa-metal-900 dark:text-white tracking-tight">
          <span class="lang-it">{entry.data.title}</span>
          <span class="lang-en">{entry.data.title_en || entry.data.title}</span>
        </h1>

        <!-- Description -->
        <p class="text-lg text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
          <span class="lang-it">{entry.data.description}</span>
          <span class="lang-en">{entry.data.description_en || entry.data.description}</span>
        </p>

        <!-- Meta info: Author, Models -->
        <div class="pt-2 flex flex-wrap items-center gap-4 text-xs text-alfa-metal-500">
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-alfa-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span>
              <span class="lang-it">Autore:</span>
              <span class="lang-en">Author:</span>
              <strong> {entry.data.author}</strong>
            </span>
          </div>

          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-alfa-metal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>
              <span class="lang-it">Modelli:</span>
              <span class="lang-en">Models:</span>
              {entry.data.applicableModels.join(', ')}
            </span>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- Guide Content Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- Tools & Parts Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Tools Needed -->
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs">
            <div class="flex items-center space-x-2 text-alfa-metal-900 dark:text-white font-display font-bold text-sm mb-3">
              <svg class="w-4 h-4 text-alfa-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              </svg>
              <span class="lang-it">Attrezzi Necessari</span>
              <span class="lang-en">Required Tools</span>
            </div>
            
            <ul class="space-y-1.5 text-xs text-alfa-metal-600 dark:text-alfa-metal-400 lang-it">
              {entry.data.toolsNeeded.map((tool: string) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{tool}</span>
                </li>
              ))}
            </ul>

            <ul class="space-y-1.5 text-xs text-alfa-metal-600 dark:text-alfa-metal-400 lang-en">
              {(entry.data.toolsNeeded_en && entry.data.toolsNeeded_en.length > 0 ? entry.data.toolsNeeded_en : entry.data.toolsNeeded).map((tool: string) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{tool}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Parts Needed -->
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs">
            <div class="flex items-center space-x-2 text-alfa-metal-900 dark:text-white font-display font-bold text-sm mb-3">
              <svg class="w-4 h-4 text-alfa-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
              <span class="lang-it">Ricambi & Materiali</span>
              <span class="lang-en">Parts & Materials</span>
            </div>

            <ul class="space-y-1.5 text-xs text-alfa-metal-600 dark:text-alfa-metal-400 lang-it">
              {entry.data.partsNeeded.map((part: string) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{part}</span>
                </li>
              ))}
            </ul>

            <ul class="space-y-1.5 text-xs text-alfa-metal-600 dark:text-alfa-metal-400 lang-en">
              {(entry.data.partsNeeded_en && entry.data.partsNeeded_en.length > 0 ? entry.data.partsNeeded_en : entry.data.partsNeeded).map((part: string) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{part}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Rendered Guide Body -->
        <article class="prose prose-slate dark:prose-invert max-w-none text-alfa-metal-800 dark:text-alfa-metal-200 leading-relaxed prose-headings:font-display prose-headings:tracking-tight prose-headings:text-alfa-metal-900 dark:prose-headings:text-white prose-h2:border-b prose-h2:border-alfa-metal-200 dark:prose-h2:border-alfa-metal-800 prose-h2:pb-2 prose-h2:mt-8 prose-h3:text-alfa-red-600 dark:prose-h3:text-alfa-red-400 prose-blockquote:border-l-alfa-red-600 prose-blockquote:bg-alfa-red-50/50 dark:prose-blockquote:bg-alfa-red-950/20 prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:rounded-r-lg">
          <Content />
        </article>

        <!-- Interactive Lightbox Gallery -->
        {entry.data.gallery && entry.data.gallery.length > 0 && (
          <LightboxGallery
            images={entry.data.gallery}
            title={`Galleria Fotografica Passo-Passo (${entry.data.gallery.length} foto)`}
            title_en={`Step-by-Step Photo Gallery (${entry.data.gallery.length} photos)`}
          />
        )}

      </div>

      <!-- Sticky Sidebar Column -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="sticky top-28 space-y-6">
          
          <!-- Summary Box -->
          <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 space-y-4">
            <h3 class="font-display font-bold text-base text-alfa-metal-900 dark:text-white pb-3 border-b border-alfa-metal-200 dark:border-alfa-metal-800">
              <span class="lang-it">Riepilogo Scheda Tecnica</span>
              <span class="lang-en">Technical Summary</span>
            </h3>

            <dl class="space-y-3 text-xs">
              <div class="flex justify-between">
                <dt class="text-alfa-metal-500">
                  <span class="lang-it">Categoria:</span>
                  <span class="lang-en">Category:</span>
                </dt>
                <dd class="font-semibold text-alfa-metal-900 dark:text-white text-right">
                  <span class="lang-it">{entry.data.category}</span>
                  <span class="lang-en">{entry.data.category_en || entry.data.category}</span>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-alfa-metal-500">
                  <span class="lang-it">Difficoltà:</span>
                  <span class="lang-en">Difficulty:</span>
                </dt>
                <dd class="font-semibold text-alfa-metal-900 dark:text-white text-right">
                  <span class="lang-it">{entry.data.difficulty}</span>
                  <span class="lang-en">{entry.data.difficulty_en || defaultDifficultyEn[entry.data.difficulty]}</span>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-alfa-metal-500">
                  <span class="lang-it">Tempo Richiesto:</span>
                  <span class="lang-en">Time Required:</span>
                </dt>
                <dd class="font-semibold text-alfa-metal-900 dark:text-white text-right">
                  <span class="lang-it">{entry.data.timeRequired}</span>
                  <span class="lang-en">{entry.data.timeRequired_en || entry.data.timeRequired}</span>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-alfa-metal-500">
                  <span class="lang-it">Passaggi fotografici:</span>
                  <span class="lang-en">Photo steps:</span>
                </dt>
                <dd class="font-semibold text-alfa-red-600 text-right">{entry.data.gallery.length} HD</dd>
              </div>
            </dl>

            <div class="pt-4 border-t border-alfa-metal-200 dark:border-alfa-metal-800 flex flex-col gap-2">
              <a
                href="/techtips"
                class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-semibold bg-alfa-metal-100 dark:bg-alfa-metal-800 hover:bg-alfa-metal-200 dark:hover:bg-alfa-metal-700 text-alfa-metal-900 dark:text-white transition-colors"
              >
                <span class="lang-it">← Tutte le Guide</span>
                <span class="lang-en">← All TechTips</span>
              </a>
            </div>
          </div>

          <!-- Notice Box -->
          <div class="p-5 rounded-2xl bg-alfa-red-600/5 dark:bg-alfa-red-950/20 border border-alfa-red-600/20 text-xs text-alfa-metal-600 dark:text-alfa-metal-400 space-y-2">
            <div class="flex items-center space-x-1.5 font-semibold text-alfa-red-600 dark:text-alfa-red-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span class="lang-it">Nota di Sicurezza</span>
              <span class="lang-en">Safety Notice</span>
            </div>
            <p class="leading-relaxed">
              <span class="lang-it">
                Le guide sono fornite a titolo informativo dalla community. Utilizza sempre cavalletti omologati, scollega la batteria prima di intervenire sull'elettronica e indossa dispositivi di protezione individuali.
              </span>
              <span class="lang-en">
                These guides are provided for informational purposes by the community. Always use certified axle stands, disconnect the battery before electrical work, and wear protective equipment.
              </span>
            </p>
          </div>

        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
