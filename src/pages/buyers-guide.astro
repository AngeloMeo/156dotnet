---
// src/pages/buyers-guide.astro
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const checkList = [
  {
    en: "Check that Air Con is working",
    it: "Verifica che il climatizzatore funzioni correttamente",
    noteEn: "Listen for the compressor clutch engaging and verify cold air at vents.",
    noteIt: "Ascolta l'innesto della frizione del compressore e verifica che esca aria fredda.",
    link: "/technical/tips#ac"
  },
  {
    en: "Look for corrosion over windscreen and on roof",
    it: "Controlla la presenza di corrosione sopra il parabrezza e sul tetto",
    noteEn: "Paint chips near the rubber trim can lead to early rust bubbling.",
    noteIt: "Scheggiature vicino alla guarnizione del parabrezza possono innescare bolle di ruggine.",
    link: "/technical/tips/paint"
  },
  {
    en: "Listen for clunks from front ball joints",
    it: "Ascolta se provengono tonfi o giochi dai giunti sferici anteriori",
    noteEn: "A common wear item on all 156 suspensions.",
    noteIt: "Elemento tipico di usura su tutte le sospensioni della 156.",
    link: "/technical/tips/wishbone"
  },
  {
    en: "Cam variator rattles from Twin Sparks",
    it: "Rumore metallico/diesel dal variatore di fase sui motori Twin Spark",
    noteEn: "Sounds like a diesel for 2-5 seconds on cold startup when worn out.",
    noteIt: "Suono tipico da diesel per 2-5 secondi all'avvio a freddo quando è usurato.",
    link: "/technical/tips/variator"
  },
  {
    en: "Check for flaky paint on front bumper",
    it: "Controlla se la vernice sul paraurti anteriore tende a sfogliarsi",
    noteEn: "Particularly noticeable on early red and metallic finishes.",
    noteIt: "Particolarmente evidente sui primi esemplari rossi e metallizzati.",
    link: "/technical/tips/paint"
  },
  {
    en: "Make sure rear brakes haven't seized/corroded",
    it: "Assicurati che i freni posteriori non siano bloccati o corrosi",
    noteEn: "Rear calipers can stick if sliding pins lack grease or handbrake cables corrode.",
    noteIt: "Le pinze posteriori possono bloccarsi se le guide sono secche o i cavi freno a mano corrosi.",
    link: null
  },
  {
    en: "Check if all interior/dashboard lighting is still working",
    it: "Controlla se tutte le lampadine dell'illuminazione interna/cruscotto funzionano",
    noteEn: "Center console climate rings and rev-counter bulbs frequently blow.",
    noteIt: "Le lampadine della console centrale (clima) e del contagiri si bruciano di frequente.",
    link: null
  },
  {
    en: "Check engine under tray isn't smashed - it'll ground out otherwise",
    it: "Controlla che il riparo sottomotore non sia spaccato - altrimenti toccherà terra",
    noteEn: "The standard plastic tray sits very low, especially on lowered Sportpack versions.",
    noteIt: "Il carter di serie è molto basso, specie su vetture con assetto Sportpack.",
    link: null
  },
  {
    en: "Check suspension for creaks over bumps",
    it: "Controlla la sospensione per cigolii su dossi e sconnesso",
    noteEn: "Upper wishbone rubber bushes dry out; lower wishbone rear bushes can split.",
    noteIt: "I gommini del quadrilatero alto si seccano; le boccole inferiori possono lacerarsi.",
    link: "/technical/tips/wishbone"
  },
  {
    en: "Check alarm arms properly",
    it: "Verifica che l'antifurto si inserisca regolarmente",
    noteEn: "Check boot, bonnet and door pin switches.",
    noteIt: "Verifica gli interruttori a pulsante di cofano, baule e portiere.",
    link: null
  },
  {
    en: "Check for oil leaks (it stungs a fortune for leaky balancer shaft seals)",
    it: "Controlla perdite d'olio (sostituire i paraoli degli alberi controrotanti costa un patrimonio)",
    noteEn: "On 2.0 TS engines, oil leaking onto timing belts requires prompt attention.",
    noteIt: "Sui 2.0 TS, l'olio sulle cinghie di distribuzione è pericoloso e va eliminato subito.",
    link: "/technical/tips/timing"
  },
  {
    en: "Run air con on coldest setting whilst you test drive it then feel round the spongy gasket on the plastic housing in the middle of the bulkhead to see if it gets wet",
    it: "Aziona il clima al massimo freddo durante il test drive e tocca la guarnizione spugnosa sul contenitore in plastica al centro della paratia per sentire se si bagna",
    noteEn: "Blocked condensate drains flood into the passenger footwell.",
    noteIt: "Lo scarico condensa otturato allaga il vano piedi del passeggero.",
    link: "/technical/tips/wet"
  },
  {
    en: "Test drive it in the wet and go through every puddle you can find - then check the carpets for water",
    it: "Fai un test drive sul bagnato passando nelle pozzanghere - poi controlla se la moquette è bagnata",
    noteEn: "Bulkhead grommets, pollen filter cover and floorpan plugs can let water in.",
    noteIt: "Passacavi nella paratia, coperchio filtro antipolline o tappi pianale possono far entrare acqua.",
    link: "/technical/tips/wet"
  },
  {
    en: "If you're buying from a dealer dont take the warranty if its a WHA warranty (they're 5hite)",
    it: "Se acquisti da un concessionario non fidarti di garanzie terze scadenti (nota storica: evita garanzie WHA)",
    noteEn: "Anders' authentic period advice from original UK forum experiences.",
    noteIt: "Consiglio d'epoca originale di Anders tratto dalle esperienze del forum UK.",
    link: null
  },
  {
    en: "Check edge of drivers seat for wear on the piping",
    it: "Controlla il bordo esterno del sedile guida per usura sul bordino/fianchetto",
    noteEn: "Sportpack Recaro and Momo leather bolsters wear rapidly from entry/exit.",
    noteIt: "I fianchetti sportivi Recaro e la pelle Momo si consumano rapidamente salendo e scendendo.",
    link: null
  },
  {
    en: "Check when the cam belt was last changed!",
    it: "Verifica scrupolosamente quando è stata sostituita l'ultima volta la cinghia di distribuzione!",
    noteEn: "CRITICAL: Alfa Romeo officially reduced interval to 36,000 miles (60,000 km) or 3 years.",
    noteIt: "FONDAMENTALE: intervallo ridotto ufficialmente a 60.000 km o 3 anni sui Twin Spark.",
    link: "/technical/tips/timing"
  }
];

const magazinePages = [
  {
    src: '/images/buyersguide/bguide156-1.jpg',
    thumb: '/images/buyersguide/bguide156-1s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 1',
    title: 'Auto Italia Feb 2005 - Copertina Dossier'
  },
  {
    src: '/images/buyersguide/bguide156-2.jpg',
    thumb: '/images/buyersguide/bguide156-2s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 2',
    title: 'Auto Italia Feb 2005 - Motori e Trasmissioni'
  },
  {
    src: '/images/buyersguide/bguide156-3.jpg',
    thumb: '/images/buyersguide/bguide156-3s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 3',
    title: 'Auto Italia Feb 2005 - Sospensioni e Freni'
  },
  {
    src: '/images/buyersguide/bguide156-4.jpg',
    thumb: '/images/buyersguide/bguide156-4s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 4',
    title: 'Auto Italia Feb 2005 - Elettronica ed Interni'
  },
  {
    src: '/images/buyersguide/bguide156-5.jpg',
    thumb: '/images/buyersguide/bguide156-5s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 5',
    title: 'Auto Italia Feb 2005 - Carrozzeria e Sottoscocca'
  },
  {
    src: '/images/buyersguide/bguide156-6.jpg',
    thumb: '/images/buyersguide/bguide156-6s.jpg',
    alt: 'Auto Italia Feb 2005 - Page 6',
    title: 'Auto Italia Feb 2005 - Conclusioni e Scheda Costi'
  }
];

const autocarPages = [
  {
    src: '/images/buyersguide/autocar1004-1.jpg',
    thumb: '/images/buyersguide/autocar1004-1s.jpg',
    alt: 'Autocar Oct 2004 - Page 1',
    title: 'Autocar Ottobre 2004 - Buying Alfas Part 1'
  },
  {
    src: '/images/buyersguide/autocar1004-2.jpg',
    thumb: '/images/buyersguide/autocar1004-2s.jpg',
    alt: 'Autocar Oct 2004 - Page 2',
    title: 'Autocar Ottobre 2004 - Buying Alfas Part 2'
  }
];
---

<Layout
  title="Guida all'Acquisto Alfa 156 (Buyer's Guide) | Cuore Sportivo Archive"
  description="La guida all'acquisto originale e autentica per Alfa Romeo 156 redatta da Anders con i consigli della community e scansioni ad alta risoluzione di Auto Italia e Autocar."
  currentPath="/buyers-guide"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-alfa-metal-500 mb-6">
      <a href="/" class="hover:text-alfa-red-600">Home</a>
      <span>/</span>
      <span class="text-alfa-red-600 font-bold">
        <span class="lang-it">Guida all'Acquisto</span>
        <span class="lang-en">Buyer's Guide</span>
      </span>
    </nav>

    <!-- Header Section -->
    <div class="border-b border-alfa-metal-200 dark:border-alfa-metal-800 pb-8 mb-10">
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-alfa-metal-900 dark:text-white">
        <span class="lang-it">Guida all'Acquisto Alfa Romeo 156</span>
        <span class="lang-en">Alfa Romeo 156 Buyer's Guide</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-alfa-metal-600 dark:text-alfa-metal-300 max-w-3xl leading-relaxed">
        <span class="lang-it">
          La lista di controllo definitiva redatta originariamente da <strong>Anders</strong> con il supporto degli esperti del forum <em>alfaowner.com</em>, affiancata dalla celebre checklist a 48 punti in PDF di <strong>Posty</strong> (ARDC) e dalle scansioni integrali ad alta risoluzione di <em>Auto Italia</em> e <em>Autocar</em>.
        </span>
        <span class="lang-en">
          The definitive check guide originally written by <strong>Anders</strong> with the support of <em>alfaowner.com</em> members, accompanied by <strong>Posty's</strong> 48-point PDF checklist (ARDC) and full high-resolution magazine scans from <em>Auto Italia</em> and <em>Autocar</em>.
        </span>
      </p>

      <!-- Important Notice Box -->
      <div class="mt-6 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm">
        <p class="font-semibold flex items-center space-x-2">
          <svg class="w-5 h-5 text-amber-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="lang-it">Nota importante di Anders:</span>
          <span class="lang-en">Important note from Anders:</span>
        </p>
        <p class="mt-1 pl-7 text-xs sm:text-sm">
          <span class="lang-it">
            <em>"E per favore RICORDATE: queste cose non succedono a ogni auto! Questi sono solo consigli su cosa controllare! :)"</em> — Ricorda che questi difetti non si verificano su ogni auto: se dovessimo stilare una lista simile per Audi o BMW, sarebbe altrettanto spaventosa.
          </span>
          <span class="lang-en">
            <em>"And please DO REMEMBER: these things do not happen with every car! These are only advices on what to look for! :)"</em> — If one should make a list for Audi and BMW, it would look scary as well.
          </span>
        </p>
      </div>
    </div>

    <!-- Quick Download Box: Posty's 48-Point Checklist -->
    <div class="mb-12 p-6 rounded-2xl bg-gradient-to-r from-alfa-metal-900 via-alfa-red-950 to-alfa-metal-900 text-white shadow-xl border border-alfa-red-600/30 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="inline-flex items-center space-x-2 text-xs font-mono font-bold uppercase tracking-widest text-alfa-red-400">
          <span>Official Checklist PDF</span>
          <span>•</span>
          <span>by Posty (ARDC)</span>
        </div>
        <h2 class="font-display text-xl sm:text-2xl font-bold">
          <span class="lang-it">Checklist di Ispezione a 48 Punti per Alfa 156</span>
          <span class="lang-en">48-Point Comprehensive Alfa 156 Inspection Checklist</span>
        </h2>
        <p class="text-xs sm:text-sm text-alfa-silver-300 max-w-2xl">
          <span class="lang-it">
            Porta con te questa scheda stampabile quando vai a visionare una 156 usata: motore, telaio, elettrico, carrozzeria e test su strada.
          </span>
          <span class="lang-en">
            Print and take this comprehensive inspection checklist when viewing a used 156: engine, chassis, electrics, bodywork and road test.
          </span>
        </p>
      </div>
      <a
        href="/downloads/buyersguide.pdf"
        download="alfa156-buyers-guide-posty.pdf"
        class="inline-flex items-center space-x-2 px-6 py-3.5 rounded-xl bg-alfa-red-600 hover:bg-alfa-red-700 text-white font-bold text-sm tracking-wide shadow-lg hover:shadow-alfa-red-900/50 transition-all duration-200 flex-shrink-0"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span class="lang-it">Scarica Checklist PDF</span>
        <span class="lang-en">Download PDF Checklist</span>
      </a>
    </div>

    <!-- The 16 Checkpoints by Anders -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-display text-2xl font-bold text-alfa-metal-900 dark:text-white">
            <span class="lang-it">I 16 Punti di Controllo Originali di Anders</span>
            <span class="lang-en">Anders' Original 16 Checkpoints</span>
          </h2>
          <p class="text-xs font-mono text-alfa-metal-500 mt-1">
            <span class="lang-it">I controlli fondamentali raccomandati da Anders prima dell'acquisto</span>
            <span class="lang-en">Essential pre-purchase inspection checkpoints recommended by Anders</span>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {checkList.map((item, idx) => (
          <div class="p-4 sm:p-5 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-500/50 transition-colors shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-start space-x-3">
                <span class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-alfa-red-100 dark:bg-alfa-red-950 text-alfa-red-600 dark:text-alfa-red-400 font-mono text-xs font-bold">
                  {idx + 1}
                </span>
                <div>
                  <h3 class="font-semibold text-sm sm:text-base text-alfa-metal-900 dark:text-white">
                    <span class="lang-it">{item.it}</span>
                    <span class="lang-en">{item.en}</span>
                  </h3>
                  <p class="text-xs text-alfa-metal-500 dark:text-alfa-metal-400 mt-1 italic">
                    <span class="lang-it">{item.noteIt}</span>
                    <span class="lang-en">{item.noteEn}</span>
                  </p>
                </div>
              </div>
            </div>

            {item.link && (
              <div class="mt-3 pt-3 border-t border-alfa-metal-100 dark:border-alfa-metal-800/60 flex justify-end">
                <a
                  href={item.link}
                  class="inline-flex items-center space-x-1 text-xs font-semibold text-alfa-red-600 dark:text-alfa-red-400 hover:underline"
                >
                  <span class="lang-it">Approfondisci guida dedicata →</span>
                  <span class="lang-en">Read detailed guide →</span>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Scanned Articles Section -->
    <div class="border-t border-alfa-metal-200 dark:border-alfa-metal-800 pt-12 mb-14">
      <div class="mb-8">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Dossier Storici e Scansioni Riviste dell'Epoca</span>
          <span class="lang-en">Period Magazine Scans & Dossiers</span>
        </h2>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400 mt-1">
          <span class="lang-it">
            Pubblicato su alfa156.net su autorizzazione di <em>Auto Italia Magazine</em> e <em>Autocar Magazine</em>. Clicca sulle pagine per aprirle a schermo intero ad alta risoluzione.
          </span>
          <span class="lang-en">
            Published on alfa156.net with permission from <em>Auto Italia Magazine</em> and <em>Autocar Magazine</em>. Click on pages to inspect high-resolution scans in full screen.
          </span>
        </p>
      </div>

      <!-- Auto Italia Feb 2005 (6 pages) -->
      <div class="mb-10 p-6 rounded-2xl bg-alfa-metal-50 dark:bg-alfa-metal-900/60 border border-alfa-metal-200 dark:border-alfa-metal-800">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <span class="w-3 h-3 rounded-full bg-alfa-red-600"></span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white">
              <span class="lang-it">Auto Italia — Febbraio 2005 (6 Pagine Complete)</span>
              <span class="lang-en">Auto Italia — February 2005 (6 Full Pages)</span>
            </h3>
          </div>
          <span class="text-xs font-mono text-alfa-metal-500">Buyer's Guide to Alfa 156</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
          {magazinePages.map((pg, i) => (
            <div
              class="group relative cursor-pointer overflow-hidden rounded-lg border border-alfa-metal-300 dark:border-alfa-metal-700 bg-white dark:bg-alfa-metal-950 shadow-xs hover:shadow-md transition-all duration-200"
              data-lightbox-trigger
              data-img-src={pg.src}
              data-img-title={`Auto Italia Feb 2005 - Pagina ${i + 1}`}
            >
              <img
                src={pg.src}
                alt={pg.alt}
                class="w-full h-44 object-cover object-top transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-2">
                <span class="text-[11px] font-mono text-white font-semibold">
                  <span class="lang-it">Pagina {i + 1} 🔍</span>
                  <span class="lang-en">Page {i + 1} 🔍</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Autocar Oct 2004 (2 pages) -->
      <div class="p-6 rounded-2xl bg-alfa-metal-50 dark:bg-alfa-metal-900/60 border border-alfa-metal-200 dark:border-alfa-metal-800">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <span class="w-3 h-3 rounded-full bg-alfa-red-600"></span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white">
              <span class="lang-it">Autocar Magazine — Ottobre 2004 (Guida Acquisto 156)</span>
              <span class="lang-en">Autocar Magazine — October 2004 (Buying Alfas)</span>
            </h3>
          </div>
          <span class="text-xs font-mono text-alfa-metal-500">Autocar UK</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {autocarPages.map((pg, i) => (
            <div
              class="group relative cursor-pointer overflow-hidden rounded-lg border border-alfa-metal-300 dark:border-alfa-metal-700 bg-white dark:bg-alfa-metal-950 shadow-xs hover:shadow-md transition-all duration-200"
              data-lightbox-trigger
              data-img-src={pg.src}
              data-img-title={`Autocar Ottobre 2004 - Pagina ${i + 1}`}
            >
              <img
                src={pg.src}
                alt={pg.alt}
                class="w-full h-52 object-cover object-top transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-2">
                <span class="text-[11px] font-mono text-white font-semibold">
                  <span class="lang-it">Pagina {i + 1} 🔍</span>
                  <span class="lang-en">Page {i + 1} 🔍</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- Lightbox Component for High-Res Scans -->
  <Lightbox />
</Layout>
