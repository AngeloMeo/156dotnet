---
// download.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const pdfDownloads = [
  {
    titleIt: "Checklist Acquisto Alfa 156 (Buyer's Guide)",
    titleEn: "Alfa 156 Buyer's Guide Checklist",
    filename: 'buyersguide.pdf',
    size: '72 KB',
    descIt: 'Guida completa in 48 punti per valutare un’Alfa 156 usata: controlli carrozzeria, ruggine pianale, usura braccetti, storico distribuzione e spie cruscotto.',
    descEn: 'Comprehensive 48-point checklist to inspect a used 156: floorpan rust spots, suspension wishbone play, timing belt history, and dashboard warning lights.',
    catIt: 'Guida all’Acquisto',
    catEn: "Buyer's Guide",
  },
  {
    titleIt: 'Manutenzione e Sostituzione Freni Ant/Post',
    titleEn: 'Front & Rear Brake Servicing Manual',
    filename: 'Alfa156Brakes.pdf',
    size: '1.0 MB',
    descIt: 'Manuale tecnico per la sostituzione di dischi e pastiglie anteriori e posteriori, spurgo circuito idraulico e regolazione cavo freno a mano.',
    descEn: 'Technical instructions for front and rear brake disc and pad replacement, system bleeding, and handbrake cable adjustment.',
    catIt: 'Freni & Assetto',
    catEn: 'Brakes & Chassis',
  },
  {
    titleIt: 'Installazione e Manutenzione Filtro Aria K&N',
    titleEn: 'K&N Air Filter Installation & Care',
    filename: 'Alfa156AirFilter.pdf',
    size: '983 KB',
    descIt: 'Istruzioni dettagliate per l’alloggiamento del filtro sportivo lavabile nel cassoncino originale, oliatura corretta e intervalli di lavaggio.',
    descEn: 'Detailed instructions for fitting the washable cotton filter into the factory airbox, correct re-oiling, and cleaning intervals.',
    catIt: 'Aspirazione',
    catEn: 'Intake',
  },
  {
    titleIt: 'Conversione Chiave a Scatto con Telecomando',
    titleEn: 'Flip Key Remote Conversion Guide',
    filename: 'buttonflipkey.pdf',
    size: '268 KB',
    descIt: 'Procedura per trapiantare il trasponder immobilizer Alfa Code e la scheda elettronica telecomando originale all’interno di un guscio a scatto moderno.',
    descEn: 'Procedure to transplant the Alfa Code immobilizer chip and remote circuit board into a modern folding flip key casing.',
    catIt: 'Elettronica & Chiavi',
    catEn: 'Keys & Electronics',
  },
  {
    titleIt: 'Pulizia Approfondita Corpo Farfallato',
    titleEn: 'Throttle Body Deep Cleaning Guide',
    filename: 'cleaningthrottlebody.pdf',
    size: '156 KB',
    descIt: 'Guida per rimuovere morchie e residui carboniosi dalla farfalla motorizzata, risolvendo problemi di minimo ballerino e partenze a freddo incerte.',
    descEn: 'Guide to removing oily carbon deposits from the motorized throttle butterfly, eliminating erratic idle and cold stalling.',
    catIt: 'Motore',
    catEn: 'Engine',
  },
  {
    titleIt: 'Leva & Tirante Chiusura Cofano Anteriore',
    titleEn: 'Bonnet Catch & Safety Lever Recall',
    filename: 'bonnetcatch.pdf',
    size: '3.1 MB',
    descIt: 'Documentazione tecnica relativa al richiamo e alla manutenzione della serratura e del gancio di sicurezza del cofano anteriore.',
    descEn: 'Official technical bulletin and service guide for the bonnet secondary catch mechanism and safety release lever.',
    catIt: 'Carrozzeria',
    catEn: 'Bodywork',
  },
];

const audioTracks = [
  {
    titleIt: 'Variatore di Fase Rotto / Sgranato',
    titleEn: 'Worn / Rattling Cam Variator',
    file: '/audio/badvariator-alfa156-net.mp3',
    descIt: 'Il classico tichettio metallico "tipo motore diesel" che si manifesta nei primi 5-10 secondi dopo l’avviamento sui Twin Spark 16V.',
    descEn: 'The infamous diesel-like clattering noise on cold start on 16V Twin Spark engines caused by a worn spring and internal brass splines.',
    tagIt: 'Sintomo Guasto',
    tagEn: 'Fault Sound',
    tagColor: 'text-alfa-red-600 bg-alfa-red-600/10 border-alfa-red-600/30',
  },
  {
    titleIt: 'Variatore di Fase Nuovo / Revisionato',
    titleEn: 'Healthy / New Cam Variator',
    file: '/audio/goodvariator-alfa156-net.mp3',
    descIt: 'Il corretto sound di avviamento a freddo: rotazione rotonda e silenziosa della distribuzione senza alcun rumore di battito valvole.',
    descEn: 'The proper cold start sound: immediate quiet oil pressure build-up and sweet, smooth valve train spin without clatter.',
    tagIt: 'Riferimento Ottimale',
    tagEn: 'Healthy Benchmark',
    tagColor: 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/30',
  },
  {
    titleIt: 'Tubo Flessibile di Scarico Fessurato',
    titleEn: 'Cracked Exhaust Flexi-Pipe',
    file: '/audio/flexipipe-alfa156-net.mp3',
    descIt: 'Rumore sordo di sfiato gas e risonanza cupa sotto il pianale in accelerazione dovuto al retino metallico flessibile lesionato.',
    descEn: 'Dull blowing gas leak and bassy cabin drone under acceleration caused by a torn braided downpipe flexi section.',
    tagIt: 'Diagnosi Scarico',
    tagEn: 'Exhaust Leak',
    tagColor: 'text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/30',
  },
];
---

<BaseLayout
  title="Download Guide PDF & Clip Audio Diagnostiche – Alfa Romeo 156 (156dotnet)"
  description="Scarica guide ufficiali in PDF (Buyer's Guide, freni, filtro aria, corpo farfallato) e ascolta i file audio diagnostici per variatore Twin Spark e scarichi."
>
  <!-- Hero Section -->
  <div class="relative py-12 lg:py-16 bg-alfa-metal-100 dark:bg-alfa-metal-900 border-b border-alfa-metal-200 dark:border-alfa-metal-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center space-x-2 text-xs font-semibold tracking-wider uppercase text-alfa-red-600 dark:text-alfa-red-400">
          <span class="w-2 h-2 rounded-full bg-alfa-red-600"></span>
          <span class="lang-it">Risorse & Documenti Scaricabili</span>
          <span class="lang-en">Downloadable Guides & Resources</span>
        </div>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Download Center & Diagnosi Audio</span>
          <span class="lang-en">Download Center & Audio Diagnostics</span>
        </h1>
        <p class="text-base text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
          <span class="lang-it">
            Tutti i documenti PDF storici dell'archivio pronti da scaricare e stampare per la tua officina, uniti alle clip sonore diagnostiche per identificare i problemi a orecchio.
          </span>
          <span class="lang-en">
            Historical PDF documents from the archive ready to download and print for your workshop, paired with diagnostic audio files to identify engine noises by ear.
          </span>
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    
    <!-- PDF Guides Section -->
    <section class="space-y-8">
      <div class="space-y-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-alfa-red-600">
          <span class="lang-it">Documenti Ufficiali Community</span>
          <span class="lang-en">Community Technical Documents</span>
        </span>
        <h2 class="font-display font-bold text-3xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Guide Tecniche in Formato PDF</span>
          <span class="lang-en">Technical Guides in PDF Format</span>
        </h2>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Clicca per scaricare gratuitamente o visualizzare direttamente nel browser.</span>
          <span class="lang-en">Click to download free or view directly in your browser.</span>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pdfDownloads.map((doc) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/50 transition-all duration-300 shadow-xs flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-alfa-metal-100 dark:bg-alfa-metal-800 text-alfa-metal-600 dark:text-alfa-metal-400">
                  <span class="lang-it">{doc.catIt}</span>
                  <span class="lang-en">{doc.catEn}</span>
                </span>
                <span class="font-mono text-xs text-alfa-metal-500 font-semibold">{doc.size}</span>
              </div>

              <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white leading-snug">
                <span class="lang-it">{doc.titleIt}</span>
                <span class="lang-en">{doc.titleEn}</span>
              </h3>

              <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
                <span class="lang-it">{doc.descIt}</span>
                <span class="lang-en">{doc.descEn}</span>
              </p>
            </div>

            <div class="pt-4 border-t border-alfa-metal-100 dark:border-alfa-metal-800">
              <a
                href={`/downloads/${doc.filename}`}
                download
                class="w-full inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-xl text-xs font-semibold text-white bg-alfa-red-600 hover:bg-alfa-red-700 transition-colors shadow-glow-red-sm"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span class="lang-it">Scarica PDF ({doc.size})</span>
                <span class="lang-en">Download PDF ({doc.size})</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Diagnostic Audio Section -->
    <section class="space-y-8">
      <div class="space-y-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-alfa-red-600">
          <span class="lang-it">Ascolto Comparativo</span>
          <span class="lang-en">Comparative Audio Listening</span>
        </span>
        <h2 class="font-display font-bold text-3xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Clip Audio Diagnostiche MP3</span>
          <span class="lang-en">Diagnostic Audio Clips (MP3)</span>
        </h2>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Usa le cuffie per cogliere le sfumature di frequenza e riconoscere i problemi prima che causino danni maggiori.</span>
          <span class="lang-en">Use headphones to detect fine acoustic frequencies and identify valvetrain issues before major failure.</span>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {audioTracks.map((track) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/40 transition-all space-y-4">
            <div class="flex items-center justify-between">
              <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${track.tagColor}`}>
                <span class="lang-it">{track.tagIt}</span>
                <span class="lang-en">{track.tagEn}</span>
              </span>
            </div>

            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white">
              <span class="lang-it">{track.titleIt}</span>
              <span class="lang-en">{track.titleEn}</span>
            </h3>

            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
              <span class="lang-it">{track.descIt}</span>
              <span class="lang-en">{track.descEn}</span>
            </p>

            <div class="pt-2">
              <audio controls class="w-full h-10 rounded-lg" preload="none">
                <source src={track.file} type="audio/mpeg" />
                Audio element not supported.
              </audio>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
