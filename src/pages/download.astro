---
// src/pages/download.astro
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const audioDownloads = [
  {
    titleIt: 'Alfa 156 Twin Spark con Filtro K&N (Sound Dinamico)',
    titleEn: 'Alfa 156 Twin Spark with K&N Filter (Dynamic Sound)',
    file: '/audio/knfilter-alfa156-net.mp3',
    descIt: 'Registrazione del timbro in aspirazione con filtro ad alto flusso K&N montato nell\'airbox.',
    descEn: 'Induction sound recording with K&N high-flow panel filter fitted in the factory airbox.'
  },
  {
    titleIt: 'Alfa 156 con Tubo Centrale Inox Flexipipe',
    titleEn: 'Alfa 156 with Stainless Flexipipe Center Section',
    file: '/audio/flexipipe-alfa156-net.mp3',
    descIt: 'Registrazione del borbottio di scarico con tubo flessibile diretto in acciaio inox.',
    descEn: 'Exhaust sound recording with direct stainless steel flexible center pipe.'
  },
  {
    titleIt: 'Twin Spark — Variatore di Fase Usurato (Rumore Diesel)',
    titleEn: 'Twin Spark — Worn Cam Variator (Diesel Sound)',
    file: '/audio/badvariator-alfa156-net.mp3',
    descIt: 'Il tipico ticchettio da diesel all\'avviamento a freddo quando il variatore è da sostituire.',
    descEn: 'The classic diesel-like ticking at cold start when the variator needs replacement.'
  },
  {
    titleIt: 'Twin Spark — Variatore Nuovo Aggiornato 60666199',
    titleEn: 'Twin Spark — New Updated Variator 60666199',
    file: '/audio/goodvariator-alfa156-net.mp3',
    descIt: 'Avviamento pulito, silenzioso e istantaneo con variatore originale modificato.',
    descEn: 'Clean, quiet, and instantaneous startup with the modified factory variator.'
  }
];

const pdfDownloads = [
  {
    titleIt: 'Checklist di Ispezione a 48 Punti per Alfa 156 (PDF)',
    titleEn: 'Alfa 156 48-Point Inspection Checklist (PDF)',
    file: '/downloads/buyersguide.pdf',
    author: 'Posty (ARDC)',
    size: '73 KB',
    descIt: 'La scheda di controllo definitiva da stampare e portare con sé durante la visione di una 156 usata.',
    descEn: 'The definitive checklist to print and take along when inspecting a used Alfa 156.'
  },
  {
    titleIt: 'Guida Sostituzione Dischi e Pastiglie Freni (PDF)',
    titleEn: 'Brake Discs & Pads Replacement Guide (PDF)',
    file: '/downloads/Alfa156Brakes.pdf',
    author: 'Gary',
    size: '1.0 MB',
    descIt: 'Manuale passo-passo illustrato per lo smontaggio e revisione freni anteriori e posteriori.',
    descEn: 'Step-by-step illustrated manual for front and rear brake overhaul.'
  },
  {
    titleIt: 'Installazione Filtro Aria K&N nel Box Originale (PDF)',
    titleEn: 'K&N Air Filter Installation in Factory Box (PDF)',
    file: '/downloads/Alfa156AirFilter.pdf',
    author: 'Wilson',
    size: '980 KB',
    descIt: 'Tutorial per l\'inserimento di un elemento filtrante a pannello K&N nell\'airbox di serie.',
    descEn: 'Tutorial on fitting a K&N replacement panel filter into the original airbox.'
  },
  {
    titleIt: 'Conversione Chiave a Scatto Button Flip Key (PDF)',
    titleEn: 'Button Flip Key Conversion Guide (PDF)',
    file: '/downloads/buttonflipkey.pdf',
    author: 'Michaeld',
    size: '268 KB',
    descIt: 'Guida fai-da-te per trasferire transponder immobilizer e telecomando in guscio a scatto.',
    descEn: 'DIY guide to transfer immobilizer transponder and remote PCB into a flip key casing.'
  },
  {
    titleIt: 'Manutenzione Gancio Sicurezza Cofano Motore (PDF)',
    titleEn: 'Bonnet Safety Catch Maintenance (PDF)',
    file: '/downloads/bonnetcatch.pdf',
    author: 'ARDC',
    size: '3.1 MB',
    descIt: 'Istruzioni e schema di lubrificazione per prevenire l\'apertura accidentale del cofano.',
    descEn: 'Lubrication instructions and schematics to prevent accidental bonnet release.'
  },
  {
    titleIt: 'Procedura Pulizia Corpo Farfallato Bosch (PDF)',
    titleEn: 'Bosch Throttle Body Cleaning Procedure (PDF)',
    file: '/downloads/cleaningthrottlebody.pdf',
    author: 'Community',
    size: '156 KB',
    descIt: 'Smontaggio valvola a farfalla, pulizia morchie e ripristino battuta minima.',
    descEn: 'Throttle body removal, sludge cleaning, and idle position reset.'
  }
];

const wallpapers = [
  {
    src: '/images/desktop/BERNAR31.jpg',
    thumb: '/images/desktop/BERNAR31-s.jpg',
    titleIt: 'Alfa 156 in Pista — Curva Veloce',
    titleEn: 'Alfa 156 on Track — High Speed Corner',
    res: 'Originale / 1152x864 / 800x600'
  },
  {
    src: '/images/desktop/GIOVAN21.jpg',
    thumb: '/images/desktop/GIOVAN21-s.jpg',
    titleIt: 'Alfa 156 V6 24V — Vista Dinamica',
    titleEn: 'Alfa 156 V6 24V — Dynamic View',
    res: 'Originale / 800x600'
  },
  {
    src: '/images/desktop/GIOVAN22.jpg',
    thumb: '/images/desktop/GIOVAN22-s.jpg',
    titleIt: 'Alfa 156 Dettaglio Scudetto & Fari',
    titleEn: 'Alfa 156 Grille & Headlights Detail',
    res: 'Originale / 800x600'
  }
];

const games = [
  { title: 'Need For Speed 4: High Stakes', item: 'Alfa 156 2.0 Twin Spark (3D Car Model)' },
  { title: 'Need For Speed 3: Hot Pursuit', item: 'Alfa 156 Superturismo & 2.5 V6 24V' },
  { title: 'TOCA 2 Touring Cars', item: 'Alfa 156 Selenia Official Livery Skin' }
];
---

<Layout
  title="Download & Risorse d'Epoca Alfa 156 | Cuore Sportivo Archive"
  description="L'archivio multimediale di alfa156.net: suoni motore MP3, manuali PDF scaricabili, sfondi desktop ufficiali e mod per Need For Speed e TOCA 2."
  currentPath="/download"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-alfa-metal-500 mb-6">
      <a href="/" class="hover:text-alfa-red-600">Home</a>
      <span>/</span>
      <span class="text-alfa-red-600 font-bold">Download</span>
    </nav>

    <!-- Header Section -->
    <div class="border-b border-alfa-metal-200 dark:border-alfa-metal-800 pb-8 mb-10">
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-alfa-metal-900 dark:text-white">
        <span class="lang-it">Area Download & File Multimediali</span>
        <span class="lang-en">Downloads & Multimedia Hub</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-alfa-metal-600 dark:text-alfa-metal-300 max-w-3xl leading-relaxed">
        <span class="lang-it">
          Risorse multimediali per Alfa Romeo 156: registrazioni audio autentiche dei motori, manuali tecnici in formato PDF, sfondi desktop d'epoca e add-on per simulatori di guida anni '90 e 2000.
        </span>
        <span class="lang-en">
          Complete multimedia collection for Alfa Romeo 156: authentic engine sound recordings, technical PDF service manuals, retro wallpapers, and classic racing simulator mods.
        </span>
      </p>
    </div>

    <!-- 1. AUDIO CLIPS SECTION -->
    <div class="mb-14">
      <div class="flex items-center space-x-3 mb-6">
        <span class="text-2xl">🎵</span>
        <h2 class="font-display text-2xl font-bold text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Campioni Audio Motori & Scarichi (MP3)</span>
          <span class="lang-en">Engine & Exhaust Audio Recordings (MP3)</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {audioDownloads.map((item) => (
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
            <div>
              <h3 class="font-display font-bold text-base text-alfa-metal-900 dark:text-white mb-1">
                <span class="lang-it">{item.titleIt}</span>
                <span class="lang-en">{item.titleEn}</span>
              </h3>
              <p class="text-xs text-alfa-metal-500 dark:text-alfa-metal-400 mb-3">
                <span class="lang-it">{item.descIt}</span>
                <span class="lang-en">{item.descEn}</span>
              </p>
            </div>
            <div class="pt-2 border-t border-alfa-metal-100 dark:border-alfa-metal-800">
              <audio controls class="w-full h-8 rounded" preload="metadata">
                <source src={item.file} type="audio/mpeg" />
              </audio>
              <div class="mt-2 text-right">
                <a
                  href={item.file}
                  download
                  class="text-[11px] font-mono font-bold text-alfa-red-600 dark:text-alfa-red-400 hover:underline"
                >
                  <span class="lang-it">Scarica file MP3 ↓</span>
                  <span class="lang-en">Download MP3 file ↓</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 2. PDF MANUALS & CHECKLISTS -->
    <div class="border-t border-alfa-metal-200 dark:border-alfa-metal-800 pt-12 mb-14">
      <div class="flex items-center space-x-3 mb-6">
        <span class="text-2xl">📄</span>
        <h2 class="font-display text-2xl font-bold text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Documenti Tecnici, Guide e Manuali PDF</span>
          <span class="lang-en">Technical PDF Documents & Workshop Guides</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {pdfDownloads.map((pdf) => (
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-alfa-metal-400 mb-2">
                <span>{pdf.author}</span>
                <span class="font-bold text-alfa-red-600">{pdf.size}</span>
              </div>
              <h3 class="font-display font-bold text-base text-alfa-metal-900 dark:text-white mb-2">
                <span class="lang-it">{pdf.titleIt}</span>
                <span class="lang-en">{pdf.titleEn}</span>
              </h3>
              <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed mb-4">
                <span class="lang-it">{pdf.descIt}</span>
                <span class="lang-en">{pdf.descEn}</span>
              </p>
            </div>
            <a
              href={pdf.file}
              download
              class="w-full text-center px-4 py-2 rounded-lg bg-alfa-metal-100 dark:bg-alfa-metal-800 hover:bg-alfa-red-600 hover:text-white text-xs font-mono font-bold text-alfa-metal-800 dark:text-alfa-silver-200 transition-colors"
            >
              <span class="lang-it">Scarica Documento PDF ↓</span>
              <span class="lang-en">Download PDF Document ↓</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- 3. RETRO WALLPAPERS -->
    <div class="border-t border-alfa-metal-200 dark:border-alfa-metal-800 pt-12 mb-14">
      <div class="flex items-center space-x-3 mb-6">
        <span class="text-2xl">🖼️</span>
        <h2 class="font-display text-2xl font-bold text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Sfondi Desktop Storici Windows</span>
          <span class="lang-en">Retro Windows Desktop Wallpapers</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {wallpapers.map((wp) => (
          <div class="p-4 rounded-xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
            <div
              class="group relative cursor-pointer overflow-hidden rounded-lg border border-alfa-metal-200 dark:border-alfa-metal-700 mb-3"
              data-lightbox-trigger
              data-img-src={wp.src}
              data-img-title={wp.titleIt}
            >
              <img
                src={wp.src}
                alt={wp.titleEn}
                class="w-full h-44 object-cover object-center group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-mono font-bold">
                <span class="lang-it">🔍 Anteprima</span>
                <span class="lang-en">🔍 Preview</span>
              </div>
            </div>

            <div>
              <h3 class="font-semibold text-sm text-alfa-metal-900 dark:text-white mb-1">
                <span class="lang-it">{wp.titleIt}</span>
                <span class="lang-en">{wp.titleEn}</span>
              </h3>
              <span class="text-[11px] font-mono text-alfa-metal-400 block mb-3">
                <span class="lang-it">Risoluzione:</span>
                <span class="lang-en">Resolution:</span> {wp.res}
              </span>
              <a
                href={wp.src}
                download
                class="block text-center px-3 py-1.5 rounded-lg bg-alfa-metal-100 dark:bg-alfa-metal-800 hover:bg-alfa-red-600 hover:text-white text-xs font-mono font-bold transition-colors"
              >
                <span class="lang-it">Download Sfondo ↓</span>
                <span class="lang-en">Download Wallpaper ↓</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 4. GAMING MODS RETRO -->
    <div class="border-t border-alfa-metal-200 dark:border-alfa-metal-800 pt-12">
      <div class="flex items-center space-x-3 mb-6">
        <span class="text-2xl">🕹️</span>
        <h2 class="font-display text-2xl font-bold text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Modellismo Virtuale & Videogiochi Anni 90/2000</span>
          <span class="lang-en">Retro Gaming Add-ons & 3D Models</span>
        </h2>
      </div>

      <div class="p-6 rounded-2xl bg-alfa-metal-50 dark:bg-alfa-metal-900/60 border border-alfa-metal-200 dark:border-alfa-metal-800">
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-300 mb-4 leading-relaxed">
          <span class="lang-it">
            All'apice del successo dell'Alfa 156, la community internazionale realizzò conversioni 3D e livree ufficiali per i titoli di simulazione di corsa più famosi dell'epoca:
          </span>
          <span class="lang-en">
            At the peak of the 156's racing fame, the global community built bespoke 3D cars and liveries for the era's legendary sim racing games:
          </span>
        </p>

        <ul class="space-y-3 font-mono text-xs sm:text-sm">
          {games.map((g) => (
            <li class="flex items-center space-x-3 p-3 rounded-lg bg-white dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800">
              <span class="w-2 h-2 rounded-full bg-alfa-red-600"></span>
              <strong class="text-alfa-metal-900 dark:text-white">{g.title}:</strong>
              <span class="text-alfa-metal-600 dark:text-alfa-silver-300">{g.item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

  </div>

  <Lightbox />
</Layout>
