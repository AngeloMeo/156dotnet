---
// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TechTipCard from '../components/TechTipCard.astro';
import { getCollection } from 'astro:content';

const techtips = await getCollection('techtips');
const featuredGuides = techtips.slice(0, 6);
---

<BaseLayout
  title="Alfa Romeo 156 – Cuore Sportivo & Technical Archive (156dotnet)"
  description="Il portale tecnico di riferimento per proprietari e appassionati di Alfa Romeo 156. Guide fotografiche passo-passo, diagnosi V6 Busso e Twin Spark, modifiche e storia."
>

  <!-- Hero Section -->

  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-alfa-metal-200 dark:border-alfa-metal-800">
    <!-- Subtle background carbon effect and radial glow in dark mode -->
    <div class="absolute inset-0 bg-carbon opacity-30 dark:opacity-60 pointer-events-none" />
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-alfa-red-600/15 dark:bg-alfa-red-600/25 blur-[120px] rounded-full pointer-events-none" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-alfa-red-600/10 dark:bg-alfa-red-600/20 text-alfa-red-600 dark:text-alfa-red-400 border border-alfa-red-600/30">
          <span class="w-2 h-2 rounded-full bg-alfa-red-600 animate-ping" />
          <span class="lang-it">Auto dell'Anno 1998 • 1997 - 2007</span>
          <span class="lang-en">Car of the Year 1998 • 1997 - 2007</span>
        </div>

        <!-- Main Heading -->
        <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-alfa-metal-900 dark:text-white">
          Alfa Romeo <span class="text-transparent bg-clip-text bg-gradient-to-r from-alfa-red-600 via-alfa-red-500 to-alfa-red-700">156</span>
        </h1>
        
        <p class="font-display font-semibold text-xl sm:text-2xl text-alfa-metal-700 dark:text-alfa-metal-300">
          Cuore Sportivo & Technical Archive
        </p>

        <p class="text-base sm:text-lg text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed max-w-2xl mx-auto">
          <span class="lang-it">
            Il portale tecnico completo dedicato alla manutenzione, restauro e conservazione della berlina e Sportwagon di Arese. <strong>Oltre 4.400 documenti storici</strong>, 12 guide fotografiche passo-passo e diagnosi per motori <em>Twin Spark, JTD e V6 Busso</em>.
          </span>
          <span class="lang-en">
            The definitive technical portal dedicated to the maintenance, restoration, and preservation of the Arese sports saloon and Sportwagon. <strong>Over 4,400 historical files</strong>, 12 step-by-step photographic guides, and diagnostics for <em>Twin Spark, JTD, and Busso V6</em> engines.
          </span>
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/techtips"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-white bg-alfa-red-600 hover:bg-alfa-red-700 transition-all duration-200 shadow-glow-red hover:scale-[1.02] focus:outline-none"
          >
            <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span class="lang-it">Esplora i TechTips</span>
            <span class="lang-en">Explore TechTips</span>
          </a>

          <a
            href="/storia"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-alfa-metal-800 dark:text-alfa-silver-200 bg-alfa-metal-100 dark:bg-alfa-metal-900 hover:bg-alfa-metal-200 dark:hover:bg-alfa-metal-800 border border-alfa-metal-300 dark:border-alfa-metal-700 transition-all duration-200 hover:scale-[1.02] focus:outline-none"
          >
            <svg class="w-5 h-5 mr-2 text-alfa-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span class="lang-it">Storia & Design de' Silva</span>
            <span class="lang-en">History & de' Silva Design</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Key Statistics Counter -->
  <section class="py-12 bg-white dark:bg-alfa-metal-900 border-b border-alfa-metal-200 dark:border-alfa-metal-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        
        <div class="p-4 rounded-xl bg-alfa-metal-50 dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800">
          <div class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-red-600">4.400+</div>
          <div class="text-xs sm:text-sm font-semibold text-alfa-metal-600 dark:text-alfa-metal-400 mt-1 uppercase tracking-wider">
            <span class="lang-it">File Preservati</span>
            <span class="lang-en">Preserved Files</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-alfa-metal-50 dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800">
          <div class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">12</div>
          <div class="text-xs sm:text-sm font-semibold text-alfa-metal-600 dark:text-alfa-metal-400 mt-1 uppercase tracking-wider">
            <span class="lang-it">Guide Passo-Passo</span>
            <span class="lang-en">Step Guides</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-alfa-metal-50 dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800">
          <div class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-red-600">19</div>
          <div class="text-xs sm:text-sm font-semibold text-alfa-metal-600 dark:text-alfa-metal-400 mt-1 uppercase tracking-wider">
            <span class="lang-it">Schede Diagnosi</span>
            <span class="lang-en">Diagnostic Sheets</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-alfa-metal-50 dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800">
          <div class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">25+</div>
          <div class="text-xs sm:text-sm font-semibold text-alfa-metal-600 dark:text-alfa-metal-400 mt-1 uppercase tracking-wider">
            <span class="lang-it">Cataloghi & PDF</span>
            <span class="lang-en">Catalogues & PDFs</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured TechTips Section -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div class="space-y-2">
        <div class="flex items-center space-x-2 text-alfa-red-600 font-semibold text-xs tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-alfa-red-600"></span>
          <span class="lang-it">Officina & Risoluzione Problemi</span>
          <span class="lang-en">Workshop & Troubleshooting</span>
        </div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">TechTips in Evidenza</span>
          <span class="lang-en">Featured TechTips</span>
        </h2>
        <p class="text-alfa-metal-600 dark:text-alfa-metal-400 text-sm max-w-xl">
          <span class="lang-it">Guide fotografiche dettagliate con strumenti richiesti, tempi stimati e galleria interattiva passo-passo.</span>
          <span class="lang-en">Detailed photo guides with required tools, estimated times, and interactive step-by-step lightbox gallery.</span>
        </p>
      </div>

      <a
        href="/techtips"
        class="mt-4 md:mt-0 inline-flex items-center space-x-2 text-sm font-semibold text-alfa-red-600 dark:text-alfa-red-400 hover:underline"
      >
        <span class="lang-it">Visualizza tutti i TechTips</span>
        <span class="lang-en">View all TechTips</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- TechTips Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredGuides.map((guide) => (
        <TechTipCard
          title={guide.data.title}
          title_en={guide.data.title_en}
          description={guide.data.description}
          description_en={guide.data.description_en}
          category={guide.data.category}
          category_en={guide.data.category_en}
          difficulty={guide.data.difficulty}
          difficulty_en={guide.data.difficulty_en}
          timeRequired={guide.data.timeRequired}
          timeRequired_en={guide.data.timeRequired_en}
          stepsCount={guide.data.stepsCount}
          featuredImage={guide.data.featuredImage}
          slug={guide.id}
        />
      ))}
    </div>
  </section>

  <!-- Interactive Diagnostic Audio Player Preview -->
  <section class="py-16 bg-alfa-metal-100 dark:bg-alfa-metal-900 border-y border-alfa-metal-200 dark:border-alfa-metal-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        
        <div class="lg:col-span-1 space-y-3">
          <span class="text-xs font-semibold tracking-wider uppercase text-alfa-red-600 dark:text-alfa-red-400">
            <span class="lang-it">Diagnosi Acustica Twin Spark</span>
            <span class="lang-en">Twin Spark Acoustic Diagnostics</span>
          </span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-alfa-metal-900 dark:text-white">
            <span class="lang-it">Ascolta il Tuo Motore</span>
            <span class="lang-en">Listen to Your Engine</span>
          </h2>
          <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
            <span class="lang-it">
              Il rumore "da diesel" all'avviamento a freddo è il classico sintomo del <strong>variatore di fase</strong> usurato sui motori Twin Spark 16V. Confronta i file audio reali registrati dalla community.
            </span>
            <span class="lang-en">
              The "diesel-like clatter" on cold start is the classic symptom of a worn <strong>cam variator</strong> on 16V Twin Spark engines. Compare actual diagnostic audio clips recorded by the community.
            </span>
          </p>
        </div>

        <!-- Audio Player Cards -->
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Bad Variator Sound -->
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-950 border border-alfa-red-600/30 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-sm text-alfa-red-600">
                <span class="lang-it">Variatore Usurato / Rotto</span>
                <span class="lang-en">Worn / Broken Variator</span>
              </span>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-alfa-red-600/10 text-alfa-red-600 font-semibold">
                <span class="lang-it">Tichettio Diesel</span>
                <span class="lang-en">Diesel Sound</span>
              </span>
            </div>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400">
              <span class="lang-it">Rumore metallico persistente nei primi secondi dopo l'avvio a freddo.</span>
              <span class="lang-en">Metallic clattering sound for the first few seconds upon cold startup.</span>
            </p>
            <audio controls class="w-full h-9 rounded" preload="none">
              <source src="/audio/badvariator-alfa156-net.mp3" type="audio/mpeg" />
              Audio element not supported.
            </audio>
          </div>

          <!-- Good Variator Sound -->
          <div class="p-5 rounded-xl bg-white dark:bg-alfa-metal-950 border border-emerald-500/30 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-sm text-emerald-600 dark:text-emerald-400">
                <span class="lang-it">Variatore Nuovo / Sano</span>
                <span class="lang-en">Healthy / New Variator</span>
              </span>
              <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">
                <span class="lang-it">Suono Ottimale</span>
                <span class="lang-en">Optimal Sound</span>
              </span>
            </div>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400">
              <span class="lang-it">Avviamento fluido e rotondo, assenza di battiti in testata.</span>
              <span class="lang-en">Smooth, quiet startup without top-end valve tapping or valvetrain noise.</span>
            </p>
            <audio controls class="w-full h-9 rounded" preload="none">
              <source src="/audio/goodvariator-alfa156-net.mp3" type="audio/mpeg" />
              Audio element not supported.
            </audio>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- The 6 Main Sections Navigation Hub -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">
        <span class="lang-it">Esplora le Sezioni dell'Archivio</span>
        <span class="lang-en">Explore the Archive Sections</span>
      </h2>
      <p class="text-alfa-metal-600 dark:text-alfa-metal-400 text-sm">
        <span class="lang-it">Tutto il materiale storico riorganizzato con una navigazione moderna e immediata.</span>
        <span class="lang-en">All historic materials restructured with modern, rapid navigation.</span>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: TechTips -->
      <a href="/techtips" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors mb-2">
          <span class="lang-it">TechTips & Guide</span>
          <span class="lang-en">TechTips & Guides</span>
        </h3>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Guide pratiche passo-passo illustrate con foto reali per intervenire su fari, candele V6, debimetri, maniglie e diagnosi rapida.</span>
          <span class="lang-en">Step-by-step practical guides illustrated with real photos for headlights, V6 spark plugs, MAF cleaning, door handles, and diagnostics.</span>
        </p>
      </a>

      <!-- Card 2: Modifiche -->
      <a href="/modifiche" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors mb-2">
          <span class="lang-it">Modifiche & Tuning</span>
          <span class="lang-en">Modifications & Tuning</span>
        </h3>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Assetti sportivi ribassati (Eibach / Bilstein), scarichi omologati Ragazzon, aspirazione K&N e sospensioni a quadrilatero.</span>
          <span class="lang-en">Lowered sports suspensions (Eibach / Bilstein), homologated Ragazzon exhausts, K&N intakes, and double wishbone geometry.</span>
        </p>
      </a>

      <!-- Card 3: Storia -->
      <a href="/storia" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors mb-2">
          <span class="lang-it">Storia & Design</span>
          <span class="lang-en">History & Design</span>
        </h3>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Il capolavoro di Walter de' Silva, la vittoria al Car of the Year 1998, il restyling di Giugiaro, le leggendarie GTA e i successi ETCC/DTM.</span>
          <span class="lang-en">Walter de' Silva's masterpiece, European Car of the Year 1998 victory, Giugiaro facelift, legendary GTA, and ETCC/DTM touring championships.</span>
        </p>
      </a>

      <!-- Card 4: Download & Cataloghi -->
      <a href="/download" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors mb-2">
          <span class="lang-it">Download & Cataloghi</span>
          <span class="lang-en">Downloads & Catalogues</span>
        </h3>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Scaricabili ufficiali in PDF: guida all'acquisto a 48 punti, manuali freni, cataloghi ricambi storici e clip audio.</span>
          <span class="lang-en">Official PDF downloads: 48-point buyer's guide checklist, brake manuals, historical parts catalogues, and audio clips.</span>
        </p>
      </a>

      <!-- Card 5: About -->
      <a href="/about" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors mb-2">
          <span class="lang-it">About 156dotnet</span>
          <span class="lang-en">About 156dotnet</span>
        </h3>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">La missione di conservazione del patrimonio alfa156.net, i ringraziamenti ai pionieri Anders e Jeff, e la tecnologia moderna.</span>
          <span class="lang-en">The preservation mission of alfa156.net, tributes to pioneers Anders and Jeff, and modern edge infrastructure.</span>
        </p>
      </a>

      <!-- Card 6: Dati Tecnici Motori -->
      <a href="/storia#motori" class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/60 transition-all hover:shadow-glow-red duration-300">
        <div class="w-12 h-12 rounded-xl bg-alfa-red-600/10 text-alfa-red-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
