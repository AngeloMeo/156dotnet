---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const pillars = [
  {
    titleIt: 'Specifiche Tecniche & Motori',
    titleEn: 'Technical Specs & Engines',
    descIt: 'Tutti i dati ufficiali di motori Euro 2, Euro 3, Facelift 2002 e GTA. Rapporti cambio, pesi e geometrie del quadrilatero alto.',
    descEn: 'Factory specifications for Euro 2, Euro 3, 2002 Facelift and GTA engines. Gear ratios, kerb weights and double wishbone geometry.',
    link: '/technical',
    badgeIt: 'Motori & Assetto',
    badgeEn: 'Engines & Chassis',
    icon: '⚡'
  },
  {
    titleIt: 'Problemi Noti & Guide Passo-Passo',
    titleEn: 'Known Problems & DIY Guides',
    descIt: 'I difetti congeniti storici (plancia, variatore, braccetti, infiltrazioni) e le guide fotografiche illustrate di Jeff e Anders.',
    descEn: 'The classic known faults (dash rattles, TS variator, wishbones, leaks) and illustrated photo guides by Jeff and Anders.',
    link: '/technical/tips',
    badgeIt: 'Guide & Tips',
    badgeEn: 'DIY Guides',
    icon: '🔧'
  },
  {
    titleIt: 'Guida all\'Acquisto (Buyer\'s Guide)',
    titleEn: 'Alfa 156 Buyer\'s Guide',
    descIt: 'La lista di controllo originale a 16 punti di Anders, la checklist stampabile a 48 punti di Posty e le scansioni di Auto Italia.',
    descEn: 'Anders\' original 16-point checklist, Posty\'s 48-point printable PDF checklist and full Auto Italia magazine buyer\'s dossiers.',
    link: '/buyers-guide',
    badgeIt: 'Guida Acquisto',
    badgeEn: 'Buyer\'s Guide',
    icon: '📋'
  },
  {
    titleIt: 'Dossier Tuning & Elaborazioni',
    titleEn: 'Tuning & Road Handling',
    descIt: 'Kit compressore e turbo Novitec (fino a 348 CV), rimappature Squadra Tuning, guida assetto Alfanytt e scarichi Ragazzon.',
    descEn: 'Novitec superchargers and turbos (up to 348 bhp), Squadra Tuning remaps, Alfanytt handling guide and Ragazzon exhausts.',
    link: '/technical/tuning',
    badgeIt: 'Tuning & Assetto',
    badgeEn: 'Tuning & Handling',
    icon: '🏁'
  },
  {
    titleIt: 'Archivio Styling & Bodykit d\'Epoca',
    titleEn: 'Period Styling & Bodykits',
    descIt: 'I kit estetici storici dei maggiori carrozzieri: Cadamuro Design, Novitec, Zender, Autodelta, MS Design e Lester.',
    descEn: 'The period aerodynamic packages from leading tuners: Cadamuro Design, Novitec, Zender, Autodelta, MS Design and Lester.',
    link: '/styling',
    badgeIt: 'Bodykit & Stile',
    badgeEn: 'Bodykits & Styling',
    icon: '🎨'
  },
  {
    titleIt: 'Storia del Progetto 932',
    titleEn: 'History of Project 932',
    descIt: 'La genesi del design di Walter de\' Silva, l\'ispirazione Nuvola, il trionfo di Auto dell\'Anno 1998 e le gare STC.',
    descEn: 'Walter de Silva\'s design genesis, Nuvola inspiration, Car of the Year 1998 triumph and European Super Touring titles.',
    link: '/storia',
    badgeIt: 'Storia & Premi',
    badgeEn: 'History & Heritage',
    icon: '🏆'
  }
];

const featuredGuides = [
  { slug: 'variator', titleIt: 'Variatore di fase Twin Spark (Rumore Diesel)', titleEn: 'Twin Spark Cam Variator (Diesel Sound)', tag: 'Motore' },
  { slug: 'v6sparks', titleIt: 'Sostituzione candele Busso V6 24V', titleEn: 'V6 24V Spark Plug Change', tag: 'V6' },
  { slug: 'wishbone', titleIt: 'Cigolii bracci e gommini sospensione', titleEn: 'Front Wishbone Suspension Creaks', tag: 'Assetto' },
  { slug: 'maf', titleIt: 'Debimetro / Sensore MAF: pulizia e diagnosi', titleEn: 'MAF Sensor Cleaning & Diagnosis', tag: 'Motore' },
  { slug: 'dash', titleIt: 'Rumorosità plancia e dadi prigionieri', titleEn: 'Dashboard Noise & Captive Nuts', tag: 'Interni' },
  { slug: 'timing', titleIt: 'Cinghie distribuzione: regola dei 60.000 km', titleEn: 'Timing Belts: 36,000-mile Rule', tag: 'Manutenzione' }
];
---

<Layout
  title="Alfa156.it"
  description="L'hub definitivo per tutti gli appassionati di Alfa Romeo 156. Storia del modello, specifiche tecniche, guide officina passo-passo, tuning e guida all'acquisto."
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-alfa-metal-200 dark:border-alfa-metal-800">
    <div class="absolute inset-0 bg-carbon opacity-30 dark:opacity-60 pointer-events-none" />
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-alfa-red-600/15 dark:bg-alfa-red-600/25 blur-[120px] rounded-full pointer-events-none" />

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Main Heading -->
        <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-alfa-metal-900 dark:text-white">
          Alfa Romeo <span class="text-transparent bg-clip-text bg-gradient-to-r from-alfa-red-600 via-alfa-red-500 to-alfa-red-700">156</span>
        </h1>
      
        <p class="text-base sm:text-lg text-alfa-metal-600 dark:text-alfa-metal-300 leading-relaxed max-w-2xl mx-auto">
          <span class="lang-it">
            Il capolavoro stilistico di <strong>Walter de Silva</strong> che ha salvato e rilanciato l'Alfa Romeo nel mondo. Eletta <strong>Auto dell'Anno 1998</strong>, pioniera mondiale della tecnologia <strong>Common Rail JTD</strong> e dominatrice nel motorsport. L'hub definitivo per chi guida, restaura e celebra la 156.
          </span>
          <span class="lang-en">
            Walter de Silva's design masterpiece that redefined Alfa Romeo. Voted <strong>European Car of the Year 1998</strong>, pioneer of world-first passenger <strong>Common Rail JTD</strong> technology, and touring car champion. The definitive hub for all things Alfa 156.
          </span>
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/storia"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-bold text-white bg-alfa-red-600 hover:bg-alfa-red-700 transition-all duration-200 shadow-lg hover:shadow-alfa-red-900/50 hover:scale-[1.02]"
          >
            <span class="mr-2">🏁</span>
            <span class="lang-it">Storia del Modello</span>
            <span class="lang-en">Model History</span>
          </a>

          <a
            href="/technical/tips"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-bold text-alfa-metal-800 dark:text-alfa-silver-200 bg-alfa-metal-100 dark:bg-alfa-metal-900 hover:bg-alfa-metal-200 dark:hover:bg-alfa-metal-800 border border-alfa-metal-300 dark:border-alfa-metal-700 transition-all duration-200 hover:scale-[1.02]"
          >
            <span class="mr-2 text-alfa-red-600">🔧</span>
            <span class="lang-it">Tips & Guide Officina</span>
            <span class="lang-en">Tips & DIY Guides</span>
          </a>

          <a
            href="/buyers-guide"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-bold text-alfa-metal-800 dark:text-alfa-silver-200 bg-alfa-metal-100 dark:bg-alfa-metal-900 hover:bg-alfa-metal-200 dark:hover:bg-alfa-metal-800 border border-alfa-metal-300 dark:border-alfa-metal-700 transition-all duration-200 hover:scale-[1.02]"
          >
            <span class="mr-2 text-alfa-red-600">📋</span>
            <span class="lang-it">Guida all'Acquisto</span>
            <span class="lang-en">Buyer's Guide</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- The 6 Pillars Section -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">
        <span class="lang-it">Tutto sull'Alfa 156: Esplora l'Hub</span>
        <span class="lang-en">All Things Alfa 156: Explore the Hub</span>
      </h2>
      <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400 mt-2">
        <span class="lang-it">Dalla meccanica alle guide d'officina passo-passo, dai test prestazionali alla storia: ogni risorsa in un unico luogo.</span>
        <span class="lang-en">From factory engineering to step-by-step DIY guides, performance tuning, and history: every resource in one place.</span>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((p) => (
        <a
          href={p.link}
          class="group p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-2 rounded-xl bg-alfa-metal-100 dark:bg-alfa-metal-800">{p.icon}</span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium text-alfa-metal-600 dark:text-alfa-silver-300 bg-alfa-metal-100 dark:bg-alfa-metal-800 border border-alfa-metal-200 dark:border-alfa-metal-700">
                <span class="lang-it">{p.badgeIt}</span>
                <span class="lang-en">{p.badgeEn}</span>
              </span>
            </div>

            <h3 class="font-display font-bold text-xl text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 dark:group-hover:text-alfa-red-400 transition-colors">
              <span class="lang-it">{p.titleIt}</span>
              <span class="lang-en">{p.titleEn}</span>
            </h3>

            <p class="text-xs sm:text-sm text-alfa-metal-600 dark:text-alfa-metal-300 mt-2.5 leading-relaxed">
              <span class="lang-it">{p.descIt}</span>
              <span class="lang-en">{p.descEn}</span>
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-alfa-metal-100 dark:border-alfa-metal-800/80 flex items-center justify-between text-xs font-mono font-bold text-alfa-red-600 dark:text-alfa-red-400">
            <span>Accedi alla sezione</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Popular Guides -->
  <section class="py-16 bg-alfa-metal-50 dark:bg-alfa-metal-900/60 border-t border-alfa-metal-200 dark:border-alfa-metal-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-alfa-red-600 font-bold">Diagnosi Rapida</span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-alfa-metal-900 dark:text-white mt-1">
            <span class="lang-it">Le Guide Tecniche Più Consultate</span>
            <span class="lang-en">Most Consulted Technical Guides</span>
          </h2>
        </div>
        <a
          href="/technical/tips"
          class="mt-4 md:mt-0 inline-flex items-center space-x-1 text-sm font-bold text-alfa-red-600 hover:underline"
        >
          <span>Tutte le 21 guide complete</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredGuides.map((g) => (
          <a
            href={`/technical/tips/${g.slug}`}
            class="p-4 rounded-xl bg-white dark:bg-alfa-metal-950 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-500/50 transition-colors shadow-xs flex items-center justify-between group"
          >
            <div>
              <span class="text-[10px] font-mono uppercase text-alfa-red-600 font-semibold block mb-1">
                {g.tag}
              </span>
              <h3 class="font-semibold text-sm text-alfa-metal-900 dark:text-white group-hover:text-alfa-red-600 transition-colors">
                <span class="lang-it">{g.titleIt}</span>
                <span class="lang-en">{g.titleEn}</span>
              </h3>
            </div>
            <span class="text-xs text-alfa-metal-400 group-hover:translate-x-1 transition-transform ml-2">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Model Milestones / Timeline -->
  <section class="py-16 lg:py-24 border-t border-alfa-metal-200 dark:border-alfa-metal-800 bg-white/50 dark:bg-alfa-metal-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">I Traguardi di un'Icona (1997 - 2007)</span>
          <span class="lang-en">Milestones of an Icon (1997 - 2007)</span>
        </h2>
        <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400 mt-2">
          <span class="lang-it">Dieci anni di produzione, oltre 680.000 esemplari e una serie ininterrotta di vittorie sportive e innovazioni ingegneristiche.</span>
          <span class="lang-en">A decade of production, over 680,000 units built, and an unbroken legacy of motorsport triumphs and engineering milestones.</span>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Milestone 1 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-display font-black text-2xl text-alfa-red-600 dark:text-alfa-red-500">1997</span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white mt-2">
              <span class="lang-it">Il Debutto a Francoforte</span>
              <span class="lang-en">Frankfurt World Premiere</span>
            </h3>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 mt-2 leading-relaxed">
              <span class="lang-it">Presentata al Salone IAA '97, stupisce il mondo con le linee scultoree di Walter de Silva e le iconiche maniglie posteriori nascoste.</span>
              <span class="lang-en">Unveiled at IAA Frankfurt '97, stunning the automotive world with Walter de Silva's coupe profile and concealed rear door handles.</span>
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-alfa-metal-100 dark:border-alfa-metal-800 text-[11px] font-mono text-alfa-metal-500">
            Design Centro Stile Alfa
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-display font-black text-2xl text-alfa-red-600 dark:text-alfa-red-500">1998</span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white mt-2">
              <span class="lang-it">Auto dell'Anno Europea</span>
              <span class="lang-en">European Car of the Year</span>
            </h3>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 mt-2 leading-relaxed">
              <span class="lang-it">Prima Alfa Romeo a vincere l'ambito titolo con un distacco record di 454 punti, superando Volkswagen Golf IV e Audi A6.</span>
              <span class="lang-en">The first Alfa Romeo in history to claim the prestigious COTY trophy by a record 454 points, defeating VW Golf IV and Audi A6.</span>
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-alfa-metal-100 dark:border-alfa-metal-800 text-[11px] font-mono text-alfa-metal-500">
            Car of the Year 1998
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-display font-black text-2xl text-alfa-red-600 dark:text-alfa-red-500">1997-02</span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white mt-2">
              <span class="lang-it">Pioniera Common Rail</span>
              <span class="lang-en">Common Rail Pioneer</span>
            </h3>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 mt-2 leading-relaxed">
              <span class="lang-it">Prima auto passeggeri al mondo con iniezione diretta Common Rail Unijet (JTD), unita a sospensioni anteriori a quadrilatero alto per handling da riferimento.</span>
              <span class="lang-en">The world's first production car with Unijet Common Rail direct injection (JTD), mated with high double-wishbone front suspension.</span>
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-alfa-metal-100 dark:border-alfa-metal-800 text-[11px] font-mono text-alfa-metal-500">
            Ingegneria & Handling
          </div>
        </div>

        <!-- Milestone 4 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 shadow-xs flex flex-col justify-between">
          <div>
            <span class="font-display font-black text-2xl text-alfa-red-600 dark:text-alfa-red-500">GTA & ETCC</span>
            <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white mt-2">
              <span class="lang-it">Leggenda GTA & Corse</span>
              <span class="lang-en">GTA Legend & Motorsport</span>
            </h3>
            <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 mt-2 leading-relaxed">
              <span class="lang-it">Il debutto del mitico 3.2 Busso V6 24V sulla GTA e 4 titoli europei turismo (ETCC) consecutivi vinti dalla 156 con Fabrizio Giovanardi e Gabriele Tarquini.</span>
              <span class="lang-en">The launch of the legendary 3.2 Busso V6 GTA and 4 consecutive European Touring Car Championship (ETCC) titles with Giovanardi and Tarquini.</span>
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-alfa-metal-100 dark:border-alfa-metal-800 text-[11px] font-mono text-alfa-metal-500">
            4x Campione ETCC
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/storia"
          class="inline-flex items-center space-x-2 px-6 py-3 rounded-xl font-semibold text-sm text-alfa-red-600 dark:text-alfa-red-400 bg-alfa-red-50 dark:bg-alfa-red-950/40 hover:bg-alfa-red-100 dark:hover:bg-alfa-red-900/40 border border-alfa-red-200 dark:border-alfa-red-800/80 transition-colors"
        >
          <span class="lang-it">Approfondisci la storia completa del Progetto 932</span>
          <span class="lang-en">Explore the full history of Project 932</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
