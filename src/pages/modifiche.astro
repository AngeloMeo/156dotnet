---
// modifiche.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const modsSections = [
  {
    titleIt: 'Assetto & Sospensioni a Quadrilatero Alto',
    titleEn: 'Suspension & Double High Wishbone Setup',
    badgeIt: 'Handling',
    badgeEn: 'Handling',
    descIt: 'La 156 deve la sua straordinaria precisione d’inserimento all’avantreno a quadrilatero alto articolato e al retrotreno McPherson a bracci oscillanti sdoppiati. Scopri gli assetti più collaudati.',
    descEn: 'The 156 owes its razor-sharp turn-in precision to its double high wishbone front suspension and twin-link rear setup. Discover the most proven suspension setups.',
    itemsIt: [
      'Molle Eibach Pro-Kit (-30mm) con ammortizzatori Bilstein B6 / B8',
      'Assetto regolabile a ghiera Koni Sport (Gialli)',
      'Sostituzione boccole con silentblock in poliuretano Powerflex (serie Purple o Black)',
      'Barre antirollio maggiorate GTA (24mm ant / 16mm post)',
    ],
    itemsEn: [
      'Eibach Pro-Kit springs (-30mm) with Bilstein B6 / B8 dampers',
      'Koni Sport (Yellow) adjustable rebound dampers',
      'Powerflex polyurethane suspension bushes (Purple road or Black track series)',
      'GTA upgraded anti-roll sway bars (24mm front / 16mm rear)',
    ],
  },
  {
    titleIt: 'Impianti di Scarico Sportivi',
    titleEn: 'Sports Exhaust Systems',
    badgeIt: 'Sound & Performance',
    badgeEn: 'Sound & Performance',
    descIt: 'Come liberare il caratteristico sound Alfa Romeo esaltando i bassi e gli alti regimi senza risonanze fastidiose a velocità di crociera.',
    descEn: 'How to unleash the iconic Alfa Romeo exhaust note across low and high RPMs without annoying motorway highway drone.',
    itemsIt: [
      'Terminale sportivo Ragazzon in acciaio INOX 100% (omologato CEE)',
      'Centrale diretto senza silenziatore intermedio per V6 Busso',
      'Collettori di scarico equalizzati in acciaio INOX per 2.5 V6 e 3.2 GTA',
      'Downpipe decatalizzato o catalizzatore metallico 200 celle per JTD 16V/20V',
    ],
    itemsEn: [
      'Ragazzon 100% stainless steel rear silencer (EEC road legal)',
      'Straight-through unsilenced center pipe for Busso V6',
      'Equal-length stainless steel front downpipes for 2.5 V6 and 3.2 GTA',
      'Decat downpipe or 200-cell sports catalytic converter for JTD 16V/20V',
    ],
  },
  {
    titleIt: 'Aspirazione & Filtrazione',
    titleEn: 'Air Intake & Filtration',
    badgeIt: 'Respirazione Motore',
    badgeEn: 'Engine Breathing',
    descIt: 'Miglioramento del flusso d’aria in camera di combustione e sound di aspirazione all’apertura della farfalla.',
    descEn: 'Improving airflow into the combustion chamber and enhancing inductive intake roar under wide open throttle.',
    itemsIt: [
      'Filtro a pannello in cotone multistrato lavabile K&N / BMC nel cassoncino originale',
      'Eliminazione risonatore aria inferiore (GTA intake mod) per pescare aria fresca dal passaruota',
      'Manicotti di aspirazione in silicone rinforzato a 4 strati resistenti a calore e depressione',
      'Corpo farfallato lucidato a specchio (flusso ottimizzato)',
    ],
    itemsEn: [
      'K&N / BMC washable high-flow multi-layer cotton panel filter in stock airbox',
      'Lower intake resonator deletion (GTA intake duct mod) for colder wheel arch air',
      '4-ply reinforced silicone intake hoses resisting heat soak and collapse',
      'Mirror-polished throttle body internal tract for smoothed velocity',
    ],
  },
  {
    titleIt: 'Freni & Sicurezza Attiva',
    titleEn: 'Brakes & Stopping Power',
    badgeIt: 'Staccata & Frenata',
    badgeEn: 'Braking Upgrades',
    descIt: 'Upgrade dell’impianto frenante originale per eliminare il fading durante l’uso intenso in collina o in pista.',
    descEn: 'Upgrading the factory braking hardware to eradicate brake fade during spirited B-road driving and track days.',
    itemsIt: [
      'Upgrade pinze Brembo a 4 pistoncini (da 156 GTA o Fiat Coupe 20V Turbo) con dischi da 305mm o 330mm',
      'Tubi freno aeronautici in treccia metallica con guaina protettiva anti-sfregamento',
      'Pastiglie sportive ad alto coefficiente d’attrito Ferodo Racing DS2500 o EBC Redstuff',
      'Fluido freni ad alto punto di ebollizione a secco Motul RBF660 DOT4',
    ],
    itemsEn: [
      'Brembo 4-piston radial calipers (from 156 GTA or Coupe 20VT) with 305mm or 330mm discs',
      'Stainless steel braided brake lines with anti-abrasion outer coating',
      'High-friction sports compound pads (Ferodo Racing DS2500 or EBC Redstuff)',
      'High dry boiling point brake fluid (Motul RBF660 Racing DOT4)',
    ],
  },
];
---

<BaseLayout
  title="Modifiche, Assetto & Scarichi – Alfa Romeo 156 (156dotnet)"
  description="Guida alle modifiche per Alfa 156: assetti Eibach/Bilstein, scarichi sportivi Ragazzon, upgrade freni Brembo GTA e ottimizzazione aspirazione."
>
  <!-- Hero Section -->
  <div class="relative py-12 lg:py-16 bg-alfa-metal-100 dark:bg-alfa-metal-900 border-b border-alfa-metal-200 dark:border-alfa-metal-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex items-center space-x-2 text-xs font-semibold tracking-wider uppercase text-alfa-red-600 dark:text-alfa-red-400">
          <span class="w-2 h-2 rounded-full bg-alfa-red-600"></span>
          <span class="lang-it">Tuning & Performance</span>
          <span class="lang-en">Tuning & Performance</span>
        </div>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Modifiche & Ottimizzazioni</span>
          <span class="lang-en">Modifications & Tuning</span>
        </h1>
        <p class="text-base text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
          <span class="lang-it">
            Come affinare la dinamica di guida e il piacere al volante dell'Alfa 156, mantenendo l'affidabilità e l'omologazione per l'uso su strada.
          </span>
          <span class="lang-en">
            How to hone driving dynamics and behind-the-wheel pleasure in the Alfa 156, while maintaining road legality and everyday reliability.
          </span>
        </p>
      </div>
    </div>
  </div>

  <!-- Sections Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {modsSections.map((sec) => (
        <div class="p-8 rounded-2xl bg-white dark:bg-alfa-metal-900 border border-alfa-metal-200 dark:border-alfa-metal-800 hover:border-alfa-red-600/50 transition-all duration-300 shadow-sm space-y-5">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-md text-xs font-semibold bg-alfa-red-600/10 text-alfa-red-600 dark:text-alfa-red-400 border border-alfa-red-600/20">
              <span class="lang-it">{sec.badgeIt}</span>
              <span class="lang-en">{sec.badgeEn}</span>
            </span>
          </div>

          <h2 class="font-display font-bold text-2xl text-alfa-metal-900 dark:text-white">
            <span class="lang-it">{sec.titleIt}</span>
            <span class="lang-en">{sec.titleEn}</span>
          </h2>

          <p class="text-sm text-alfa-metal-600 dark:text-alfa-metal-400 leading-relaxed">
            <span class="lang-it">{sec.descIt}</span>
            <span class="lang-en">{sec.descEn}</span>
          </p>

          <div class="pt-2 border-t border-alfa-metal-100 dark:border-alfa-metal-800">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-alfa-metal-500 mb-3">
              <span class="lang-it">Upgrade Consigliati dalla Community:</span>
              <span class="lang-en">Community Recommended Upgrades:</span>
            </h3>
            
            <ul class="space-y-2 text-xs text-alfa-metal-700 dark:text-alfa-metal-300 lang-it">
              {sec.itemsIt.map((item) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <ul class="space-y-2 text-xs text-alfa-metal-700 dark:text-alfa-metal-300 lang-en">
              {sec.itemsEn.map((item) => (
                <li class="flex items-start space-x-2">
                  <span class="text-alfa-red-600 font-bold">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Download Link Box -->
    <div class="mt-12 p-6 rounded-2xl bg-alfa-metal-100 dark:bg-alfa-metal-900/60 border border-alfa-metal-200 dark:border-alfa-metal-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1">
        <h3 class="font-display font-bold text-lg text-alfa-metal-900 dark:text-white">
          <span class="lang-it">Cataloghi Ricambi & Schede Tecniche PDF</span>
          <span class="lang-en">Parts Catalogues & PDF Technical Sheets</span>
        </h3>
        <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400">
          <span class="lang-it">Consulta e scarica i listini parti speciali e le guide d'installazione ufficiali dei freni e dei filtri.</span>
          <span class="lang-en">Browse and download special parts lists and official brake & filter installation guides.</span>
        </p>
      </div>
      <a
        href="/download"
        class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-alfa-red-600 hover:bg-alfa-red-700 transition-colors shrink-0 shadow-glow-red-sm"
      >
        <span class="lang-it">Vai ai Download PDF</span>
        <span class="lang-en">Go to PDF Downloads</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</BaseLayout>
