---
// src/pages/storia.astro
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';

const timelineEvents = [
  {
    year: '1993',
    titleIt: 'Genesi del Progetto 932 e Centro Stile',
    titleEn: 'Genesis of Project 932 & Centro Stile',
    descIt: 'Alfa Romeo decide che è tempo di creare l\'erede dell\'Alfa 155. Tre progetti in competizione: Pininfarina, Italdesign e il Centro Stile Alfa Romeo guidato da Walter de\' Silva. L\'idea vincente combina tre storiche Alfa Romeo: la 1900, la Giulietta e la Giulia.',
    descEn: 'In 1993 Alfa Romeo decided there was time to release a successor to the Alfa 155. Three competing designs: Pininfarina, Italdesign, and Centro Stile (led by Walter de Silva). The winning design combined three historic Alfa Romeos: the 1900, Giulietta and Giulia.',
    image: '/images/history/156_front.jpg',
    captionIt: 'Il frontale scolpito con lo scudetto prominente che scende fino al paraurti.',
    captionEn: 'The sculpted front end with prominent scudetto dipping into the bumper.'
  },
  {
    year: '1996 - 1997',
    titleIt: 'L\'Ispirazione Nuvola e le Maniglie Nascoste',
    titleEn: 'Nuvola Inspiration & Hidden Rear Handles',
    descIt: 'Il design finale è direttamente ispirato dall\'esperienza della concept Alfa Romeo Nuvola. Le linee spigolose dei decenni precedenti scompaiono a favore di superfici tese e sinuose, come "la pancia snella di una tigre selvaggia pronta all\'attacco". Le celebri maniglie posteriori annegate nel montante conferiscono alla berlina l\'eleganza dinamica di un coupé.',
    descEn: 'The Centro Stile design drew direct inspiration from the Alfa Romeo Nuvola concept. The side profile evokes associations with a wild tiger\'s slim belly ready to attack. The famous rear door handles concealed in the C-pillar give this four-door saloon the sleek appearance of a pure coupé.',
    image: '/images/history/walter.jpg',
    captionIt: 'Walter de\' Silva mentre discute il design delle maniglie posteriori.',
    captionEn: 'Walter de Silva discussing the design of the rear door handles.'
  },
  {
    year: '1997 - 1998',
    titleIt: 'Il Debutto a Francoforte e Auto dell\'Anno 1998',
    titleEn: 'Frankfurt Launch & Car of the Year 1998',
    descIt: 'Presentata il 9 ottobre 1997 al Salone di Francoforte, l\'Alfa 156 stupisce il pubblico internazionale. Nel 1998 conquista lo stimato premio europeo di Auto dell\'Anno (Car of the Year 1998) con un distacco schiacciante, diventando il più grande successo commerciale della storia moderna del marchio con oltre 500.000 unità prodotte.',
    descEn: 'Launched on 9th of October 1997 at the Frankfurt Motor Show, the 156 captivated enthusiasts worldwide. The following year it received the prestigious Car Of The Year 1998 award by an overwhelming margin, becoming the largest commercial success in Alfa Romeo\'s history with over 500,000 units sold.',
    image: '/images/history/156_dash.jpg',
    captionIt: 'La plancia sportiva con i due quadranti a cannocchiale rivolti al pilota.',
    captionEn: 'The sporty driver-oriented dashboard with dual instrument pods.'
  },
  {
    year: '2000',
    titleIt: 'Il Debutto della Sportwagon a Ginevra',
    titleEn: 'Sportwagon Debut at Geneva Motor Show',
    descIt: 'Al Salone di Ginevra del marzo 2000 debutta la 156 Sportwagon. Più che una comune station wagon votata solo al carico, la Sportwagon nasce come vera e propria vettura di stile: la silhouette posteriore armoniosa e slanciata crea il concetto di "lifestyle estate", senza sacrificare l\'assetto stradale e il dinamismo.',
    descEn: 'In March 2000 the Sportwagon was unveiled at the Geneva Motor Show. Design took precedence over mere boot volume: the Sportwagon pioneered the premium "lifestyle estate" concept, marrying shooting-brake elegance with sports saloon dynamics.',
    image: '/images/history/alfa_156sw_3f.jpg',
    captionIt: 'Foto spia durante i collaudi della nuova Sportwagon pre-lancio.',
    captionEn: 'Spy picture from a test drive of the new Sportwagon pre-launch.'
  },
  {
    year: '2001 - 2002',
    titleIt: 'Titolo Europeo STC e Nascita della GTA',
    titleEn: 'STC Championship & The Legendary GTA',
    descIt: 'Nel 2001 l\'Alfa 156 domina il Campionato Europeo Turismo (STC Teams Championship). Al Salone di Francoforte 2001 viene svelata la mitica 156 GTA con il glorioso 3.2 V6 Busso da 250 CV. La vettura fu esposta con vetri completamente oscurati per non svelare in anticipo gli interni ristilizzati previsti per il restyling 2002.',
    descEn: 'In 2001 the Alfa 156 captured the European Super Touring (STC) Teams Championship. At the Frankfurt Motor Show, the 156 GTA was presented with Giuseppe Busso\'s 3.2 24V V6 producing 250 bhp. Its windows were blacked out to prevent the public from glimpsing the upcoming 2002 interior.',
    image: '/images/history/gruppo1.jpg',
    captionIt: 'L\'Alfa 156 vittoriosa nel Campionato Europeo Turismo STC 2001.',
    captionEn: 'The Alfa 156 winning the European Super Touring (STC) Championship.'
  },
  {
    year: '2002',
    titleIt: 'Il Restyling Interno e il Prototipo GTAm 3.5 V6',
    titleEn: '2002 Interior Facelift & The 3.5 GTAm Prototype',
    descIt: 'Nella primavera 2002 arriva il primo aggiornamento: paraurti e specchietti in tinta carrozzeria, nuovo volante multifunzione, clima bi-zona, schermo infocenter centrale superiore, controllo di stabilità VDC di serie e debutto del motore 2.0 JTS a iniezione diretta da 165 CV. Il 26 novembre 2002 viene annunciato il prototipo GTAm con motore 3.5 V6 da 300 CV a 6800 giri, cerchi da 19" e freni Brembo da 330 mm.',
    descEn: 'Spring 2002 brought body-coloured bumper inserts, dual-zone climate, new multifunction infocenter screen, standard VDC, and the direct-injection 2.0 JTS engine (165 bhp). On 26 November 2002, Alfa Romeo announced the wild 156 GTAm with a 3.5 V6 developing 300 bhp at 6800 rpm, 19" wheels and 330mm Brembo brakes.',
    image: '/images/history/gtam1.jpg',
    captionIt: 'L\'Alfa Romeo 156 GTAm: 3.5 V6 da 300 CV, purtroppo rimasta un prototipo.',
    captionEn: 'The Alfa Romeo 156 GTAm prototype: 3.5 V6 with 300 bhp.'
  },
  {
    year: '2003 - 2005',
    titleIt: 'Restyling Giugiaro, Crosswagon Q4 ed Epilogo',
    titleEn: 'Giugiaro Facelift, Crosswagon Q4 & Epilogue',
    descIt: 'Nel 2003 arriva il secondo restyling firmato da Giorgetto Giugiaro, con il frontale ispirato alla concept Brera, proiettori affilati e scudetto imponente. Nel 2004 debutta la Crosswagon Q4 con trazione integrale permanente a tre differenziali con Torsen C (58% di coppia al posteriore). Nel 2005 si chiude la produzione della 156 per cedere il passo all\'Alfa 159, dopo aver salvato il futuro dell\'Alfa Romeo.',
    descEn: 'In 2003 Giorgetto Giugiaro penned the second facelift with a bold Brera-inspired scudetto. In 2004 the Crosswagon Q4 arrived with permanent Torsen C four-wheel drive (58% rear torque bias). In 2005 production concluded as the 159 arrived, cementing an extraordinary era that saved Alfa Romeo.',
    image: '/images/history/facelift2.jpg',
    captionIt: 'Il secondo restyling del 2003 firmato da Giorgetto Giugiaro.',
    captionEn: 'The second facelift in 2003 designed by Giorgetto Giugiaro.'
  }
];
---

<Layout
  title="Storia del Progetto 932 (Alfa Romeo 156) | Cuore Sportivo Archive"
  description="La storia integrale e autentica del Progetto 932: la genesi stilistica di Walter de' Silva, le competizioni, il premio Auto dell'Anno 1998 e le evoluzioni GTA e Crosswagon Q4."
  currentPath="/storia"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-alfa-metal-500 mb-6">
      <a href="/" class="hover:text-alfa-red-600">Home</a>
      <span>/</span>
      <span class="text-alfa-red-600 font-bold">
        <span class="lang-it">Storia</span>
        <span class="lang-en">History</span>
      </span>
    </nav>

    <!-- Header Section -->
    <div class="border-b border-alfa-metal-200 dark:border-alfa-metal-800 pb-8 mb-10">
      <h1 class="font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-alfa-metal-900 dark:text-white">
        <span class="lang-it">Storia dell'Alfa Romeo 156 (Progetto 932)</span>
        <span class="lang-en">History of Alfa Romeo 156 (Project 932)</span>
      </h1>

      <p class="mt-4 text-base sm:text-lg text-alfa-metal-600 dark:text-alfa-metal-300 max-w-3xl leading-relaxed">
        <span class="lang-it">
          La narrazione documentale completa: dalla competizione del 1993 tra Pininfarina, Italdesign e Walter de' Silva, ai retroscena economici, le vittorie in pista e le tappe che hanno salvato e rilanciato la casa del Biscione.
        </span>
        <span class="lang-en">
          The complete documentary narrative: from the 1993 styling competition between Pininfarina, Italdesign, and Walter de Silva, to the financial background, racing titles, and milestones that revitalized Alfa Romeo.
        </span>
      </p>
    </div>

    <!-- Timeline Progression -->
    <div class="space-y-16 mb-16">
      {timelineEvents.map((evt, idx) => (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Text Column -->
          <div class={`lg:col-span-7 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="flex items-center space-x-3 mb-2">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-extrabold bg-alfa-red-600 text-white shadow-xs">
                {evt.year}
              </span>
              <span class="text-xs font-mono uppercase tracking-widest text-alfa-metal-400">Tappa {idx + 1}</span>
            </div>

            <h2 class="font-display text-2xl sm:text-3xl font-bold text-alfa-metal-900 dark:text-white mt-1 mb-4">
              <span class="lang-it">{evt.titleIt}</span>
              <span class="lang-en">{evt.titleEn}</span>
            </h2>

            <p class="text-sm sm:text-base text-alfa-metal-600 dark:text-alfa-metal-300 leading-relaxed">
              <span class="lang-it">{evt.descIt}</span>
              <span class="lang-en">{evt.descEn}</span>
            </p>
          </div>

          <!-- Image Column with Lightbox -->
          <div class={`lg:col-span-5 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div
              class="group relative cursor-pointer overflow-hidden rounded-2xl border border-alfa-metal-200 dark:border-alfa-metal-800 bg-white dark:bg-alfa-metal-900 shadow-md hover:shadow-xl transition-all duration-300"
              data-lightbox-trigger
              data-img-src={evt.image}
              data-img-title={evt.captionIt}
            >
              <img
                src={evt.image}
                alt={evt.titleEn}
                class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="p-3 bg-white dark:bg-alfa-metal-900 border-t border-alfa-metal-100 dark:border-alfa-metal-800">
                <p class="text-xs text-alfa-metal-600 dark:text-alfa-metal-400 font-mono">
                  <span class="lang-it">{evt.captionIt}</span>
                  <span class="lang-en">{evt.captionEn}</span>
                </p>
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Final Note from Anders -->
    <div class="border-t border-alfa-metal-200 dark:border-alfa-metal-800 pt-8 text-center text-xs font-mono text-alfa-metal-500">
      <p>
        <span class="lang-it">
          "Un'era è finita e il successo dell'Alfa Romeo 156 ha salvato il futuro dell'Alfa Romeo." — Anders Bull, webmaster@alfa156.net
        </span>
        <span class="lang-en">
          "An era is over and the success of the Alfa Romeo 156 has saved the future of Alfa Romeo." — Anders Bull, webmaster@alfa156.net
        </span>
      </p>
    </div>

  </div>

  <Lightbox />
</Layout>
